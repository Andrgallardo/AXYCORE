# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional SMTP settings for live email dispatch (used alongside Firebase Cloud Functions)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="AxyCore Notificaciones <notificaciones@axycore.local>"

# Web Push VAPID public key (used by PushManager & Firebase Cloud Messaging)
# Configured for instant Web Push activation on credit application status changes
VITE_FIREBASE_VAPID_KEY="BEl62iUYgUivxIkv69yViEuiBIa-Ib9-SkvMeAtA3LFgDZKrxZFuSjSmOWzIN542P1w1Gm8yEs6_O1uvWCWzW_A"
# Optional server-side VAPID private key & contact subject for background RFC 8292 Web Push dispatch
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:notificaciones@axycore.local"

# Optional WhatsApp Business Cloud API (Meta) for AxyRecovery Bot live dispatch
WHATSAPP_CLOUD_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""

# Optional Banking Statement Connector API for automated reconciliation
BANK_CONNECTOR_API_URL=""
BANK_CONNECTOR_API_KEY=""

# Optional AppSheet Source Platform Migration Credentials
APPSHEET_MIGRATION_APP_ID="0c599c8f-ec7b-477a-9c38-1067df6fd959"
APPSHEET_MIGRATION_ACCESS_KEY=""

# Optional 32+ char master key for AES-256-GCM encryption of DGII PKCS#12 digital certificates at rest
DGII_CERT_MASTER_KEY=""
