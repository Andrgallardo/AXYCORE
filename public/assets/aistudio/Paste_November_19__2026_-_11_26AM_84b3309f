/* AxyCore — motor de simulación integrado, 2026-10-02.

 * ESTADO: motor en Apps Script, módulo web integrado desde Inicio de AppSheet.

 * No crea operaciones reales.

 * Tasas expresadas como porcentaje MENSUAL (5 significa 5%).

 * Conversión según fuente del motor existente: diaria /30, semanal /4,

 * quincenal /2, mensual /1. Insoluta: cuota nivelada, como el motor existente.

 * Configuración única sustituible por reglas cargadas de PARAMETROS al integrar.

 * Los límites inferiores son exclusivos salvo el mínimo 1: no quedan huecos

 * entre, por ejemplo, 1,000.00 y 1,001.00 para montos con centavos.

 */

function crearMotorCalculadoraAxyCore() {

  'use strict';

  var CONFIG = {

    DOP: [

      {hasta:30000, tasa:5, gasto:1000},

      {hasta:150000, tasa:4.5, gasto:1500},

      {hasta:null, tasa:4, gastoPorcentaje:3}

    ],

    USD: [

      {hasta:1000, tasa:5, gasto:20},

      {hasta:1500, tasa:5, gasto:25},

      {hasta:2000, tasa:4.5, gasto:35},

      {hasta:3000, tasa:4, gasto:50},

      {hasta:5000, tasa:4, gasto:75},

      {hasta:null, tasa:4, gastoPorcentaje:3}

    ],

    frecuencias: {

      Diaria:{divisor:30,dias:1,unidad:'días'},

      Semanal:{divisor:4,dias:7,unidad:'semanas'},

      Quincenal:{divisor:2,dias:15,unidad:'quincenas'},

      Mensual:{divisor:1,meses:1,unidad:'meses'}

    },

    maxCuotas:10000

  };

  function exigir(ok,mensaje) { if (!ok) throw new Error(mensaje); }

  function enteroDecimal(valor,precision,nombre) {

    exigir(typeof valor==='number'||typeof valor==='string',nombre+' requerido');

    var texto=String(valor).trim();

    exigir(/^\d+(?:\.\d+)?$/.test(texto),nombre+' debe ser un número no negativo');

    var partes=texto.split('.'), decimales=partes[1]||'';

    exigir(decimales.length<=precision,nombre+' excede la precisión admitida');

    return BigInt(partes[0]+decimales.padEnd(precision,'0'));

  }

  function dividirRedondeando(n,d) { return (n+d/BigInt(2))/d; }

  function importe(centavos) {

    exigir(centavos<=BigInt(Number.MAX_SAFE_INTEGER),'Monto fuera del límite de precisión');

    return Number(centavos)/100;

  }

  function fechaISO(texto) {

    exigir(typeof texto==='string'&&/^\d{4}-\d{2}-\d{2}$/.test(texto),'Fecha requerida en formato AAAA-MM-DD');
    var d=new Date(texto+'T12:00:00Z');
    exigir(Number.isFinite(d.getTime())&&d.toISOString().slice(0,10)===texto,'Fecha inválida');

    return d;

  }

  function vencimiento(fecha,numero,frecuencia) {

    var d=new Date(fecha.getTime());

    if(frecuencia.meses) {

      var dia=d.getUTCDate();

      d.setUTCDate(1); d.setUTCMonth(d.getUTCMonth()+numero*frecuencia.meses);

      var ultimo=new Date(Date.UTC(d.getUTCFullYear(),d.getUTCMonth()+1,0)).getUTCDate();

      d.setUTCDate(Math.min(dia,ultimo));

    } else d.setUTCDate(d.getUTCDate()+numero*frecuencia.dias);

    exigir(Number.isFinite(d.getTime()),'Fecha de vencimiento fuera de rango');

    return d.toISOString().slice(0,10);

  }

  function regla(moneda,monto,config) {

    var reglas=config[moneda];

    exigir(Array.isArray(reglas)&&reglas.length>0,'Moneda sin configuración');

    var anterior=BigInt(0);

    for(var i=0;i<reglas.length;i++) {

      var r=reglas[i];

      if(r.hasta===null) {

        exigir(i===reglas.length-1,'El rango abierto debe ser el último');

        return r;

      }

      var limite=enteroDecimal(r.hasta,2,'Límite');

      exigir(limite>anterior,'Rangos desordenados o duplicados'); anterior=limite;

      if(monto<=limite) return r;

    }

    throw new Error('Monto sin regla configurada');

  }

  function gastoLegal(p,r) {

    return r.gastoPorcentaje!==undefined

      ?dividirRedondeando(p*enteroDecimal(r.gastoPorcentaje,6,'Porcentaje de gastos'),BigInt(100000000))

      :enteroDecimal(r.gasto,2,'Gasto legal');

  }

  function sugerir(moneda,monto,config) {

    config=config||CONFIG;

    exigir(moneda==='DOP'||moneda==='USD','Seleccione moneda');

    var p=enteroDecimal(monto,2,'Monto');

    exigir(p>=BigInt(100),'Monto mínimo: 1 en la moneda seleccionada'); importe(p);

    var r=regla(moneda,p,config);

    return {tasa:r.tasa,gastosLegales:importe(gastoLegal(p,r))};

  }

  function calcular(datos,config) {

    config=config||CONFIG;

    exigir(datos&&typeof datos==='object','Datos del préstamo requeridos');

    exigir(datos.moneda==='DOP'||datos.moneda==='USD','Seleccione moneda');

    var p=enteroDecimal(datos.monto,2,'Monto');

    exigir(p>=BigInt(100),'Monto mínimo: 1 en la moneda seleccionada'); importe(p);
    var f=config.frecuencias[datos.frecuencia];
    exigir(!!f,'Seleccione frecuencia');

    exigir(Number.isSafeInteger(f.divisor)&&f.divisor>0,'Conversión de frecuencia inválida');

    exigir(typeof datos.plazo==='number'&&Number.isSafeInteger(datos.plazo)&&datos.plazo>0,

      'El plazo debe ser un número entero de cuotas mayor que cero');

    exigir(datos.plazo<=config.maxCuotas,'Plazo superior al máximo parametrizado');

    exigir(datos.tipo==='Fija'||datos.tipo==='Insoluta','Seleccione tipo de interés');
    var modalidadPago=datos.modalidadPago||'Normal';
    exigir(modalidadPago==='Normal'||modalidadPago==='SoloInteresesInicial','Seleccione modalidad de pago');
    var cuotasSoloInteres=modalidadPago==='SoloInteresesInicial'?Number(datos.cuotasSoloInteres||0):0;
    exigir(Number.isSafeInteger(cuotasSoloInteres)&&cuotasSoloInteres>=0,'Las cuotas de solo intereses deben ser un número entero no negativo');
    exigir(cuotasSoloInteres<datos.plazo,'Las cuotas de solo intereses deben ser menores que el plazo total');
    var cuotasAmortizacion=datos.plazo-cuotasSoloInteres;

    exigir(datos.gastos==='Descontar'||datos.gastos==='Financiar','Seleccione tratamiento de gastos');

    exigir(typeof datos.usarSugerida==='boolean','Indique si desea utilizar la tasa sugerida');

    var fecha=fechaISO(datos.fecha), r=regla(datos.moneda,p,config);

    var tasa=enteroDecimal(datos.usarSugerida?r.tasa:datos.tasaPersonalizada,6,'Tasa');

    var divisor=BigInt(100000000)*BigInt(f.divisor);

    var gasto=gastoLegal(p,r);

    var financiado=p+(datos.gastos==='Financiar'?gasto:BigInt(0));

    var neto=p-(datos.gastos==='Descontar'?gasto:BigInt(0));

    exigir(neto>BigInt(0),'Los gastos descontados deben ser inferiores al monto solicitado'); importe(financiado);

    var cambio=datos.moneda==='USD'?enteroDecimal(datos.tasaCambio,6,'Tasa de cambio'):null;

    if(cambio!==null) exigir(cambio>BigInt(0),'La tasa de cambio debe ser mayor que cero');

    var balance=financiado, interesTotal=BigInt(0), cuotas=[], n=datos.plazo;
    var capitalFijo=financiado/BigInt(cuotasAmortizacion);
    var interesFijo=dividirRedondeando(financiado*tasa,divisor);
    var nivelada=null;
    if(datos.tipo==='Insoluta'&&tasa>BigInt(0)) {
      var periodica=Number(tasa)/Number(divisor);
      var calculo=Number(financiado)*periodica/(-Math.expm1(-cuotasAmortizacion*Math.log1p(periodica)));
      exigir(Number.isFinite(calculo)&&calculo<=Number.MAX_SAFE_INTEGER,'Cuota fuera de rango');
      nivelada=BigInt(Math.round(calculo));
    }
    for(var k=1;k<=n;k++) {
      var soloInteres=k<=cuotasSoloInteres;
      var interes=datos.tipo==='Fija'?interesFijo:dividirRedondeando(balance*tasa,divisor);
      var capital=BigInt(0);
      if(!soloInteres) {
        capital=(datos.tipo==='Fija'||tasa===BigInt(0))?capitalFijo:nivelada-interes;
        exigir(capital>=BigInt(0),'La precisión monetaria produce una cuota insuficiente para cubrir el interés');
        if(k===n||capital>balance) capital=balance;
      }
      balance-=capital; interesTotal+=interes;
      cuotas.push({numero:k,fecha:vencimiento(fecha,k,f),etapa:soloInteres?'Solo intereses':'Amortización',capital:importe(capital),interes:importe(interes),cuota:importe(capital+interes),balance:importe(balance)});
    }

    exigir(balance===BigInt(0),'El plan no liquida el capital');

    var total=financiado+interesTotal;

    var salida={moneda:datos.moneda,montoSolicitado:importe(p),frecuencia:datos.frecuencia,

      plazo:n,unidadPlazo:f.unidad,numeroCuotas:n,fechaDesembolso:datos.fecha,

      tasaSugerida:r.tasa,tasaAplicada:Number(tasa)/1000000,tasaBase:'Mensual',

      tasaPeriodicaPorcentaje:Number(tasa)/1000000/f.divisor,

      origenTasa:datos.usarSugerida?'Automática':'Personalizada',tipo:datos.tipo,
      modalidadPago:modalidadPago,cuotasSoloInteres:cuotasSoloInteres,cuotasAmortizacion:cuotasAmortizacion,

      esquema:datos.tipo==='Fija'?'Capital e interés fijos; ajuste final de centavos'

        :'Cuota nivelada con interés sobre balance; ajuste final de centavos',

      gastosLegales:importe(gasto),modalidadGastos:datos.gastos,

      montoFinanciado:importe(financiado),montoNetoRecibir:importe(neto),

      cuotaInicial:cuotas[0].cuota,cuotaFinal:cuotas[n-1].cuota,

      cuotasIguales:cuotas.every(function(c){return c.cuota===cuotas[0].cuota;}),

      totalCapital:importe(financiado),totalIntereses:importe(interesTotal),

      totalGastosLegales:importe(gasto),totalAPagar:importe(total),

      costoTotalIncluyendoGastos:importe(total+(datos.gastos==='Descontar'?gasto:BigInt(0))),cuotas:cuotas};

    if(cambio!==null) {
      salida.tasaCambio=Number(cambio)/1000000; salida.equivalenteDOP={};

      ['montoSolicitado','gastosLegales','montoFinanciado','montoNetoRecibir','cuotaInicial',
        'cuotaFinal','totalCapital','totalIntereses','totalGastosLegales','totalAPagar',

        'costoTotalIncluyendoGastos'].forEach(function(campo) {

          salida.equivalenteDOP[campo]=importe(dividirRedondeando(

            enteroDecimal(salida[campo].toFixed(2),2,campo)*cambio,BigInt(1000000)));

        });

      salida.cuotasDOP=cuotas.map(function(c){var v={numero:c.numero,fecha:c.fecha,etapa:c.etapa};

        ['capital','interes','cuota','balance'].forEach(function(campo){

          v[campo]=importe(dividirRedondeando(enteroDecimal(c[campo].toFixed(2),2,campo)*cambio,BigInt(1000000)));

        }); return v;

      });

    }

    return salida;

  }

  function comparar(datos,config) {

    return {fija:calcular(Object.assign({},datos,{tipo:'Fija'}),config),

      insoluta:calcular(Object.assign({},datos,{tipo:'Insoluta'}),config)};

  }

  function calcularConParametros(datos,filas) {

    exigir(Array.isArray(filas),'PARAMETROS no disponible');

    var registros=filas.filter(function(f){return f.ID_PARAMETRO==='CALCULADORA_CONFIG_V1' &&

      (f.ACTIVO===true || /^(true|sí|si|yes|y|1|on)$/i.test(String(f.ACTIVO)));});

    exigir(registros.length===1,'Debe existir una única configuración activa de calculadora');

    return calcular(datos,JSON.parse(registros[0].VALOR_TEXTO));

  }

  return {configuracion:CONFIG,sugerir:sugerir,calcular:calcular,comparar:comparar,calcularConParametros:calcularConParametros};

}

var AxyCalculadora=crearMotorCalculadoraAxyCore();



function probarCalculadoraAxyCore() {

