    {moneda:'USD',tasaCambio:0},{moneda:'USD',tasaCambio:-1},{moneda:'USD',tasaCambio:''},
    {gastos:''},{tipo:''},{monto:100,gastos:'Descontar'}].forEach(function(v,i){

      caso('Validación '+(i+1),function(){falla(function(){AxyCalculadora.calcular(datos(v));});});});

  ['Fija','Insoluta'].forEach(function(tipoPeriodo){
