/** Módulo web de simulación. No contiene claves ni lee registros operativos. */

function doGet(e) {
  if(e&&e.parameter&&(e.parameter.vista==='motor'||e.parameter.vista==='config'))return mdDoGetPanelPrincipal(e);

  try {
    var config=obtenerCondicionesCalculadoraAxyCore();

    try {
      var cambioBCRD=obtenerTasaCambioBCRD();
      config.tasaCambioPredeterminada=cambioBCRD.venta;
      config.tasaCambioFuente=cambioBCRD.fuente+' · Tasa de venta';
      config.tasaCambioFecha=cambioBCRD.fecha;
      config.tasaCambioAutomatica=true;
      config.tasaCambioRespaldo=!!cambioBCRD.respaldo;
    } catch(errorCambio) {
      config.tasaCambioAutomatica=false;
      config.tasaCambioRespaldo=false;
      config.tasaCambioFuente='Manual';
    }

    var datos=JSON.stringify(config).replace(/</g,'\\\u003c');

    var motor=crearMotorCalculadoraAxyCore.toString()+';var AxyCalculadora=crearMotorCalculadoraAxyCore();';

    var html=AXY_CALCULADORA_HTML.replace('__AXY_CONFIG__',function(){return datos;})

      .replace('__AXY_ENGINE__',function(){return motor;});

    return HtmlService.createHtmlOutput(html).setTitle('AxyCore | Calculadora de Préstamos')

      .addMetaTag('viewport','width=device-width,initial-scale=1');

  } catch(e) {

    return HtmlService.createHtmlOutput('<h1>AxyCore · Calculadora</h1><p>No fue posible cargar las condiciones desde PARAMETROS. Revise la configuración y la conexión de AxyCore antes de simular.</p>');

  }
}



/** Instalación idempotente del acceso: no crea ninguna operación financiera. */

function instalarAccesoCalculadoraAxyCore() {

  var filas=leerTablaAppSheet('PARAMETROS');

  var existentes=filas.filter(function(f){return f.ID_PARAMETRO==='MENU_INICIO_07';});

  var url='https\://script.google.com/macros/s/AKfycbwzO8bQQ2T8SZnmZoePyyMX9c1cSvuC5yca5_c6-Kv_hmQI14SrIaJ7ok41jbPRueXE/exec';

  if(existentes.length>1) throw new Error('Hay accesos duplicados; revise PARAMETROS.');

  if(existentes.length===1) {

    if(existentes[0].VALOR_TEXTO!==url) throw new Error('MENU_INICIO_07 ya está ocupado por otro acceso.');

  } else {

    agregarFilasAppSheet('PARAMETROS',[{ID_PARAMETRO:'MENU_INICIO_07',

      NOMBRE:'🧮 Calculadora de Préstamos',CATEGORIA:filas.filter(function(f){return f.ID_PARAMETRO==='MENU_INICIO_06';})[0].CATEGORIA,VALOR:7,

      VALOR_TEXTO:url,ACTIVO:true,DESCRIPCION:'Simular DOP/USD, comparar intereses y consultar amortización'}]);

  }

  var verificar=leerTablaAppSheet('PARAMETROS').filter(function(f){return f.ID_PARAMETRO==='MENU_INICIO_07';});

  if(verificar.length!==1 || verificar[0].VALOR_TEXTO!==url) throw new Error('No se confirmó el acceso guardado.');

  editarFilasAppSheet('PARAMETROS',[{ID_PARAMETRO:'CALCULADORA_CONFIG_V1',DESCRIPCION:'Condiciones mensuales suministradas el 02/10/2026. Calculadora de simulación integrada desde Inicio mediante Apps Script. Cambio USD/DOP automático desde BCRD (tasa de venta), editable y con respaldo de última tasa oficial válida. No crea operaciones reales.'}]);

  console.log(JSON.stringify({estado:'PASS',acceso:verificar[0].NOMBRE,tabla:'PARAMETROS',duplicados:false}));

}