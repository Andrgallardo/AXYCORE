  ['Diaria','Semanal','Quincenal','Mensual'].forEach(function(f){

    ['Fija','Insoluta'].forEach(function(t){['Descontar','Financiar'].forEach(function(g){

      caso('DOP '+f+' '+t+' '+g,function(){verificar(AxyCalculadora.calcular(datos({
        frecuencia:f,plazo:f==='Diaria'?120:12,tipo:t,gastos:g})));});

    });});
  });

  [[1000,5,20],[1000.01,5,25],[1001,5,25],[1500,5,25],[1500.01,4.5,35],

    [1501,4.5,35],[2000,4.5,35],[2000.01,4,50],[2001,4,50],[3000,4,50],

    [3000.01,4,75],[3001,4,75],[5000,4,75],[5000.01,4,150],[5001,4,150.03]]

    .forEach(function(v){caso('USD límite '+v[0],function(){

      var r=AxyCalculadora.calcular(datos({moneda:'USD',monto:v[0],tasaCambio:63.5}));

      igual(r.tasaAplicada,v[1]);igual(r.gastosLegales,v[2]);verificar(r);

    });});

  [[30000,5,1000],[30000.01,4.5,1500],[30001,4.5,1500],[150000,4.5,1500],

    [150000.01,4,4500],[150001,4,4500.03]].forEach(function(v){

      caso('DOP límite '+v[0],function(){var r=AxyCalculadora.calcular(datos({monto:v[0]}));

        igual(r.tasaAplicada,v[1]);igual(r.gastosLegales,v[2]);verificar(r);});});

  caso('Referencia fija DOP 100000 4.5% mensual 12 cuotas',function(){

    var r=AxyCalculadora.calcular(datos());igual(r.totalIntereses,54000);

    igual(r.totalAPagar,154000);igual(r.montoNetoRecibir,98500);igual(r.cuotaInicial,12833.33);});

  caso('USD 2000 financiado, tasa manual 3%',function(){

    var r=AxyCalculadora.calcular(datos({moneda:'USD',monto:2000,tasaCambio:63.5,

      gastos:'Financiar',usarSugerida:false,tasaPersonalizada:3}));

    igual(r.tasaAplicada,3);igual(r.montoFinanciado,2035);igual(r.montoNetoRecibir,2000);

    igual(r.totalIntereses,732.6);igual(r.totalAPagar,2767.6);

    igual(r.equivalenteDOP.montoFinanciado,129222.5);verificar(r);});

  caso('USD insoluta, semanal, financiado',function(){verificar(AxyCalculadora.calcular(

    datos({moneda:'USD',monto:5001,tasaCambio:63.5,tipo:'Insoluta',frecuencia:'Semanal',gastos:'Financiar'})));});

  caso('Tasa cero y redondeo final',function(){var r=AxyCalculadora.calcular(datos({

    usarSugerida:false,tasaPersonalizada:0,tipo:'Insoluta'}));igual(r.totalIntereses,0);verificar(r);});

  caso('Financiar conserva rango sobre monto original',function(){var r=AxyCalculadora.calcular(

    datos({monto:150000,gastos:'Financiar'}));igual(r.tasaAplicada,4.5);igual(r.gastosLegales,1500);});

  caso('Fechas mensuales fin de mes y año bisiesto',function(){var r=AxyCalculadora.calcular(

    datos({fecha:'2028-01-31',plazo:3}));igual(r.cuotas[0].fecha,'2028-02-29');

    igual(r.cuotas[1].fecha,'2028-03-31');igual(r.cuotas[2].fecha,'2028-04-30');});

  [['Diaria','2026-10-03'],['Semanal','2026-10-09'],['Quincenal','2026-10-17'],

    ['Mensual','2026-11-02']].forEach(function(v){caso('Fecha '+v[0],function(){

      igual(AxyCalculadora.calcular(datos({frecuencia:v[0]})).cuotas[0].fecha,v[1]);});});

  caso('Comparación conserva entradas y disminuye intereses insolutos',function(){var d=datos(),original=JSON.stringify(d);

    var c=AxyCalculadora.comparar(d);igual(JSON.stringify(d),original);

    if(!(c.insoluta.cuotas[0].interes>c.insoluta.cuotas[11].interes&&

      c.insoluta.totalIntereses<c.fija.totalIntereses))throw new Error('Comparación inválida');});

  caso('Configuración PARAMETROS sustituye las reglas sin duplicarlas',function(){

