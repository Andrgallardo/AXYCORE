  function verificar(r){

    igual(r.cuotas.length,r.numeroCuotas);igual(r.cuotas[r.cuotas.length-1].balance,0);

    var cap=0,int=0,total=0,prev=Math.round(r.montoFinanciado*100);

    r.cuotas.forEach(function(c){var cp=Math.round(c.capital*100),it=Math.round(c.interes*100);

      igual(Math.round(c.cuota*100),cp+it);igual(Math.round(c.balance*100),prev-cp);

      cap+=cp;int+=it;total+=Math.round(c.cuota*100);prev-=cp;});

    igual(cap,Math.round(r.montoFinanciado*100));igual(int,Math.round(r.totalIntereses*100));

    igual(total,Math.round(r.totalAPagar*100));

