      for(var j=0;j<5;j++) { igual(r.cuotas[j].capital,0); igual(r.cuotas[j].balance,r.montoFinanciado); }

      if(!(r.cuotas[5].capital>0)) throw new Error('La cuota 6 debe comenzar a amortizar capital');

      igual(r.cuotas[11].balance,0); verificar(r);

    });

  });

  caso('Por período rechaza una cantidad igual al plazo total',function(){

    falla(function(){AxyCalculadora.calcular(datos({plazo:12,modalidadPago:'SoloInteresesInicial',cuotasSoloInteres:12}));});

  });

  return {estado:'PASS',alcance:'Pruebas locales del motor; integración AppSheet pendiente',

    total:resultados.length,resultados:resultados};

}



