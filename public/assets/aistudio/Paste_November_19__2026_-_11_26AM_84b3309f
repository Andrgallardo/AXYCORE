  function caso(nombre,fn){fn();resultados.push({prueba:nombre,resultado:'PASS'});}

  function igual(a,b){if(a!==b)throw new Error(String(a)+' != '+String(b));}

  function falla(fn){var rechazado=false;try{fn();}catch(e){rechazado=true;}

    if(!rechazado)throw new Error('Se esperaba validación');}

  function datos(extra){return Object.assign({moneda:'DOP',monto:100000,frecuencia:'Mensual',

