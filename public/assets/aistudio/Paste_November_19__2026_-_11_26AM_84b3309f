/** Lee exclusivamente la configuración de simulación usando la conexión existente. */

function obtenerCondicionesCalculadoraAxyCore() {

  var filas=leerTablaAppSheet('PARAMETROS');

  var activas=filas.filter(function(f) {

    return f.ID_PARAMETRO==='CALCULADORA_CONFIG_V1' &&

      esVerdadero(f.ACTIVO);

  });

  if(activas.length!==1) throw new Error('Debe existir una única configuración activa CALCULADORA_CONFIG_V1 en PARAMETROS.');

  var config=JSON.parse(activas[0].VALOR_TEXTO);

  if(!config.DOP || !config.USD || !config.frecuencias) throw new Error('Configuración de calculadora incompleta.');

  return config;

}

function simularPrestamoAxyCore(datos) {

  return AxyCalculadora.comparar(datos,obtenerCondicionesCalculadoraAxyCore());

}

function probarConexionCalculadoraAxyCore() {

  var config=obtenerCondicionesCalculadoraAxyCore();

  var r=AxyCalculadora.calcular({moneda:'USD',monto:2001,frecuencia:'Mensual',plazo:12,

    fecha:'2026-10-02',usarSugerida:true,tipo:'Fija',gastos:'Financiar',tasaCambio:63.5},config);

  if(r.tasaAplicada!==4 || r.gastosLegales!==50 || r.numeroCuotas!==12) throw new Error('La configuración real no coincide con las condiciones autorizadas.');

  console.log(JSON.stringify({estado:'PASS',fuente:'PARAMETROS',moneda:r.moneda,monto:r.montoSolicitado,tasa:r.tasaAplicada,gastos:r.gastosLegales,cuotas:r.numeroCuotas}));

}



/** Extrae la tasa de VENTA desde la página pública oficial del BCRD. */
function extraerTasaCambioBCRD(html) {

  if(typeof html!=='string' || !html) throw new Error('Respuesta vacía del BCRD.');

  var texto=html
    .replace(/<script\b[^>]*>[\s\S]*?<\/script>/gi,' ')
    .replace(/<style\b[^>]*>[\s\S]*?<\/style>/gi,' ')
    .replace(/<[^>]+>/g,' ')
    .replace(/&nbsp;|&#160;/gi,' ')
    .replace(/&amp;/gi,'&')
    .replace(/\s+/g,' ')
    .trim();

  var pos=texto.toLowerCase().indexOf('tipo de cambio');
  if(pos<0) throw new Error('No se encontró el bloque de tipo de cambio del BCRD.');

  var bloque=texto.slice(pos,pos+1500);
  var venta=bloque.match(/\bVenta\s*(?:RD\$?\s*)?([0-9]{1,3}(?:[.,][0-9]{2,6})?)/i);
  if(!venta) throw new Error('No se encontró la tasa de venta del BCRD.');

  var valor=Number(venta[1].replace(',','.'));
  if(!Number.isFinite(valor) || valor<=0 || valor>500) throw new Error('Tasa de venta BCRD fuera de rango.');

  var fecha=bloque.match(/(\d{1,2}\s+de\s+[A-Za-zÁÉÍÓÚÑáéíóúñ]+\s+(?:de\s+)?\d{4})/i);

  return {venta:valor,fecha:fecha?fecha[1]:'Última publicada',fuente:'Banco Central de la República Dominicana (BCRD)'};
}

/** Obtiene la tasa oficial; conserva la última válida como respaldo. */
function obtenerTasaCambioBCRD() {

  var claveCache='AXY_TASA_USD_DOP_BCRD_V1';
  var claveRespaldo='AXY_TASA_USD_DOP_BCRD_ULTIMA';
  var cache=CacheService.getScriptCache();
  var guardada=cache.get(claveCache);

  if(guardada) {
    var desdeCache=JSON.parse(guardada);
    desdeCache.desdeCache=true;
    return desdeCache;
  }

  try {
    var respuesta=UrlFetchApp.fetch('https://www.bancentral.gov.do/',{
      method:'get',
      followRedirects:true,
      muteHttpExceptions:true,
      headers:{'User-Agent':'Mozilla/5.0 (compatible; AxyCore/1.0)'}
    });

    var codigo=respuesta.getResponseCode();
    if(codigo<200 || codigo>=300) throw new Error('BCRD respondió HTTP '+codigo+'.');

    var tasa=extraerTasaCambioBCRD(respuesta.getContentText());
    tasa.obtenidaEn=Utilities.formatDate(new Date(),'America/Santo_Domingo',"yyyy-MM-dd'T'HH:mm:ss");
    tasa.respaldo=false;

    var json=JSON.stringify(tasa);
    cache.put(claveCache,json,3600);
    PropertiesService.getScriptProperties().setProperty(claveRespaldo,json);
    return tasa;

  } catch(e) {
    var ultima=PropertiesService.getScriptProperties().getProperty(claveRespaldo);
    if(ultima) {
      var respaldo=JSON.parse(ultima);
      respaldo.respaldo=true;
      respaldo.motivoRespaldo=String(e.message||e);
      return respaldo;
    }
    throw e;
  }
}

function probarTasaCambioBCRD() {
  var muestra='<div>Tipo de cambio 30 de Septiembre 2026 Compra 59.5224 Venta 60.0783 Reservas internacionales</div>';
  var r=extraerTasaCambioBCRD(muestra);
  if(r.venta!==60.0783) throw new Error('No se extrajo correctamente la tasa de venta.');
  if(r.fecha!=='30 de Septiembre 2026') throw new Error('No se extrajo correctamente la fecha.');
  return {estado:'PASS',venta:r.venta,fecha:r.fecha,fuente:r.fuente};
}

