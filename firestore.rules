rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Hardened Primitives ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isVerified() && request.auth.token.email.lower() == 'andrygallardo7@gmail.com';
    }

    function hasValidInvitation(invId, expectedRole, expectedOrgId) {
      return isValidId(invId)
        && exists(/databases/$(database)/documents/user_invitations/$(invId))
        && get(/databases/$(database)/documents/user_invitations/$(invId)).data.email.lower() == request.auth.token.email.lower()
        && get(/databases/$(database)/documents/user_invitations/$(invId)).data.status == 'INVITACION_ENVIADA'
        && get(/databases/$(database)/documents/user_invitations/$(invId)).data.role == expectedRole
        && get(/databases/$(database)/documents/user_invitations/$(invId)).data.organizationId == expectedOrgId;
    }

    function userExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActiveStaffDoc() {
      return isVerified() && userExists() && userDoc().status in ['ACTIVE', 'INVITED'];
    }

    function isActiveUser() {
      return isBootstrappedAdmin() || isActiveStaffDoc();
    }

    function currentRole() {
      return isBootstrappedAdmin() ? 'ADMIN' : (userExists() ? userDoc().role : 'NONE');
    }

    function inSameOrg(orgId) {
      return isValidId(orgId) && (
        isBootstrappedAdmin() ||
        (isActiveStaffDoc() && (
          userDoc().organizationId == orgId ||
          userDoc().role == 'ADMIN' ||
          ('isSuperAdmin' in userDoc() && userDoc().isSuperAdmin == true) ||
          exists(/databases/$(database)/documents/organization_memberships/$(orgId + '_' + request.auth.uid))
        ))
      );
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (isActiveStaffDoc() && userDoc().role == 'ADMIN');
    }

    function isInternalStaff(orgId) {
      return inSameOrg(orgId) && !(currentRole() in ['EXTERNAL_CLIENT', 'NONE']);
    }

    function hasOrgRole(orgId, roles) {
      return inSameOrg(orgId) && currentRole() in roles;
    }

    function canOriginate(orgId) { return hasOrgRole(orgId, ['ADMIN', 'BUSINESS_OFFICER', 'EXTERNAL_CLIENT']); }
    function canReevaluateCredit(orgId) { return hasOrgRole(orgId, ['ADMIN', 'CREDIT_ANALYST', 'RISK_OFFICER', 'BUSINESS_OFFICER', 'COMMITTEE_MEMBER', 'MANAGEMENT']); }
    function canAnalyze(orgId) { return hasOrgRole(orgId, ['ADMIN', 'CREDIT_ANALYST']); }
    function canReviewRisk(orgId) { return hasOrgRole(orgId, ['ADMIN', 'RISK_OFFICER']); }
    function canVerifyDocuments(orgId) { return hasOrgRole(orgId, ['ADMIN', 'CREDIT_ANALYST', 'RISK_OFFICER', 'FORMALIZATION']); }
    function canDecideCommittee(orgId) { return hasOrgRole(orgId, ['ADMIN', 'COMMITTEE_MEMBER']); }
    function canFormalize(orgId) { return hasOrgRole(orgId, ['ADMIN', 'FORMALIZATION']); }
    function canDisburse(orgId) { return hasOrgRole(orgId, ['ADMIN', 'OPERATIONS', 'FINANCE']); }
    function canLogCollections(orgId) { return hasOrgRole(orgId, ['ADMIN', 'COLLECTION_AGENT', 'SUPERVISOR', 'COLLECTION_COORDINATOR']); }
    function canReportPayments(orgId) { return hasOrgRole(orgId, ['ADMIN', 'FINANCE', 'OPERATIONS', 'COLLECTION_AGENT', 'CASHIER', 'SUPERVISOR', 'COLLECTION_COORDINATOR', 'BUSINESS_OFFICER', 'MANAGEMENT']); }
    function canApplyOrReversePayments(orgId) { return hasOrgRole(orgId, ['ADMIN', 'FINANCE', 'OPERATIONS', 'COLLECTION_COORDINATOR', 'MANAGEMENT']); }
    function canReconcileBank(orgId) { return hasOrgRole(orgId, ['ADMIN', 'FINANCE']); }
    function canAssignPortfolio(orgId) { return hasOrgRole(orgId, ['ADMIN', 'SUPERVISOR', 'COLLECTION_COORDINATOR']); }
    function canManageBot(orgId) { return hasOrgRole(orgId, ['ADMIN', 'COLLECTION_COORDINATOR']); }
    function canResolveDisputesAndAgreements(orgId) { return hasOrgRole(orgId, ['ADMIN', 'FINANCE', 'RISK_OFFICER', 'SUPERVISOR', 'COLLECTION_COORDINATOR', 'MANAGEMENT']); }
    function canCloseLoan(orgId) { return hasOrgRole(orgId, ['ADMIN', 'FINANCE', 'OPERATIONS']); }
    function canManageCollectionPolicies(orgId) { return hasOrgRole(orgId, ['ADMIN', 'COLLECTION_COORDINATOR']); }
    function canManageGeneralOperations(orgId) { return hasOrgRole(orgId, ['ADMIN', 'FINANCE', 'OPERATIONS', 'MANAGEMENT']); }
    function canManageAccountingAndEcf(orgId) { return hasOrgRole(orgId, ['ADMIN', 'FINANCE', 'OPERATIONS', 'MANAGEMENT']); }
    function canManageEcfInfra(orgId) { return hasOrgRole(orgId, ['ADMIN', 'FINANCE']); }

    function isValidTimestampStr(val) {
      return val is string && val.size() >= 10 && val.size() <= 40;
    }

    function optStr(d, k, m) {
      return !(k in d) || d[k] == null || (d[k] is string && d[k].size() <= m);
    }

    function optId(d, k) {
      return !(k in d) || d[k] == null || isValidId(d[k]);
    }

    function optNum(d, k) {
      return !(k in d) || d[k] == null || d[k] is number;
    }

    function optNonNeg(d, k) {
      return !(k in d) || d[k] == null || (d[k] is number && d[k] >= 0);
    }

    function optBool(d, k) {
      return !(k in d) || d[k] == null || d[k] is bool;
    }

    function optMap(d, k) {
      return !(k in d) || d[k] == null || d[k] is map;
    }

    function optList(d, k, m) {
      return !(k in d) || d[k] == null || (d[k] is list && d[k].size() <= m);
    }

    function isAllRole(r) {
      return r in [
        'ADMIN', 'BUSINESS_OFFICER', 'CREDIT_ANALYST', 'RISK_OFFICER',
        'COMMITTEE_MEMBER', 'FORMALIZATION', 'OPERATIONS', 'FINANCE',
        'AUDITOR', 'COLLECTION_AGENT', 'SUPERVISOR', 'COLLECTION_COORDINATOR',
        'CASHIER', 'MANAGEMENT', 'EXTERNAL_CLIENT'
      ];
    }

    // --- Validation Blueprints ---

    function isValidOrganization(data, orgId) {
      return data.keys().hasAll(['id', 'name', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'organizationId', 'tenantId', 'tenant_id', 'accessCode', 'name', 'legalName', 'tradeName', 'taxId', 'rnc', 'logoUrl',
          'country', 'province', 'city', 'address', 'phone', 'corporateEmail',
          'currency', 'timezone', 'status', 'onboardingDate', 'planCode',
          'licenseId', 'licenseStatus', 'licenseStartDate', 'licenseEndDate',
          'maxUsers', 'enabledModules', 'modulesEnabled', 'primaryAdminUid', 'primaryAdminName',
          'primaryAdminEmail', 'primaryAdminPhone', 'notes',
          'primaryColor', 'accentColor', 'createdAt', 'updatedAt'
        ])
        && data.id == orgId
        && isValidId(data.id)
        && (!('organizationId' in data) || (data.organizationId is string && data.organizationId == orgId))
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 160
        && optStr(data, 'tenantId', 128) && optStr(data, 'tenant_id', 128) && optStr(data, 'accessCode', 40)
        && optStr(data, 'legalName', 200) && optStr(data, 'tradeName', 160) && optStr(data, 'taxId', 40)
        && optStr(data, 'rnc', 40) && optStr(data, 'logoUrl', 600) && optStr(data, 'country', 80)
        && optStr(data, 'province', 80) && optStr(data, 'city', 80) && optStr(data, 'address', 300)
        && optStr(data, 'phone', 40) && optStr(data, 'corporateEmail', 254) && optStr(data, 'timezone', 64)
        && optStr(data, 'onboardingDate', 40) && optStr(data, 'licenseId', 128)
        && optStr(data, 'licenseStartDate', 40) && optStr(data, 'licenseEndDate', 40)
        && optStr(data, 'primaryAdminUid', 128) && optStr(data, 'primaryAdminName', 160)
        && optStr(data, 'primaryAdminEmail', 254) && optStr(data, 'primaryAdminPhone', 40)
        && optStr(data, 'notes', 1500) && optStr(data, 'primaryColor', 32) && optStr(data, 'accentColor', 32)
        && (!('currency' in data) || data.currency in ['DOP', 'USD'])
        && (!('status' in data) || data.status in ['ACTIVA', 'SUSPENDIDA', 'INACTIVA', 'PRUEBA', 'EN_REVISION', 'DESACTIVADA', 'PENDIENTE'])
        && (!('planCode' in data) || data.planCode in ['BASICO', 'PROFESIONAL', 'EMPRESARIAL', 'CORPORATIVO', 'PERSONALIZADO'])
        && (!('licenseStatus' in data) || data.licenseStatus in ['PENDIENTE', 'ACTIVA', 'PROXIMA_A_VENCER', 'VENCIDA', 'SUSPENDIDA', 'CANCELADA'])
        && (!('maxUsers' in data) || (data.maxUsers is number && data.maxUsers >= 1 && data.maxUsers <= 100000))
        && (!('enabledModules' in data) || (data.enabledModules is list && data.enabledModules.size() <= 60))
        && (!('modulesEnabled' in data) || (data.modulesEnabled is list && data.modulesEnabled.size() <= 60))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUser(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'organizationId', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'organizationId', 'isSuperAdmin', 'status', 'invitationId', 'invitationStatus', 'invitedBy', 'invitedAt', 'createdAt', 'updatedAt'])
        && data.uid == userId && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 160
        && isAllRole(data.role)
        && isValidId(data.organizationId)
        && (!('isSuperAdmin' in data) || (data.isSuperAdmin is bool && (!data.isSuperAdmin || isBootstrappedAdmin())))
        && data.status in ['ACTIVE', 'INACTIVE', 'INVITED']
        && optId(data, 'invitationId')
        && (!('invitationStatus' in data) || data.invitationStatus in ['INVITACION_ENVIADA', 'ENVIADA', 'CONFIRMADA', 'PENDIENTE'])
        && optId(data, 'invitedBy') && optStr(data, 'invitedAt', 60)
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function isValidUserInvitation(data, invitationId) {
      return data.keys().hasAll([
          'id', 'email', 'displayName', 'role', 'organizationId',
          'status', 'invitedBy', 'invitedAt', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'email', 'displayName', 'role', 'organizationId',
          'organizationName', 'accessCode', 'status', 'invitedBy', 'invitedByEmail',
          'invitedAt', 'invitationLink', 'authStatus', 'emailDeliveryChannel',
          'acceptedUid', 'acceptedAt', 'createdAt', 'updatedAt'
        ])
        && data.id == invitationId && isValidId(data.id)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 160
        && isAllRole(data.role) && isValidId(data.organizationId)
        && optStr(data, 'organizationName', 160) && optStr(data, 'accessCode', 40)
        && data.status in ['INVITACION_ENVIADA', 'ACCEPTED', 'REVOKED']
        && isValidId(data.invitedBy) && optStr(data, 'invitedByEmail', 254)
        && data.invitedAt is string && data.invitedAt.size() <= 60
        && optStr(data, 'invitationLink', 600) && optStr(data, 'authStatus', 64)
        && optStr(data, 'emailDeliveryChannel', 80) && optId(data, 'acceptedUid') && optStr(data, 'acceptedAt', 60)
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function isValidCustomer(data, customerId) {
      return data.keys().hasAll(['id', 'organizationId', 'documentType', 'documentNumber', 'documentKey', 'firstName', 'lastName', 'phone', 'createdBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'organizationId', 'documentType', 'documentNumber', 'documentKey',
          'firstName', 'lastName', 'birthDate', 'nationality', 'maritalStatus',
          'phone', 'altPhone', 'email', 'address', 'municipality', 'province',
          'residenceMonths', 'housingType', 'housingPayment',
          'socialMediaDeclared', 'socialMediaHandle', 'altContactName', 'altContactPhone',
          'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.id == customerId && isValidId(data.id) && isValidId(data.organizationId)
        && data.documentType in ['CEDULA', 'PASAPORTE']
        && data.documentNumber is string && data.documentNumber.size() >= 5 && data.documentNumber.size() <= 40
        && data.documentKey is string && data.documentKey.size() >= 6 && data.documentKey.size() <= 180
        && data.firstName is string && data.firstName.size() >= 1 && data.firstName.size() <= 120
        && data.lastName is string && data.lastName.size() >= 1 && data.lastName.size() <= 120
        && data.phone is string && data.phone.size() >= 7 && data.phone.size() <= 40
        && optStr(data, 'birthDate', 20) && optStr(data, 'nationality', 80) && optStr(data, 'maritalStatus', 40)
        && optStr(data, 'altPhone', 40) && optStr(data, 'email', 254) && optStr(data, 'address', 300)
        && optStr(data, 'municipality', 100) && optStr(data, 'province', 100)
        && (!('residenceMonths' in data) || (data.residenceMonths is number && data.residenceMonths >= 0 && data.residenceMonths <= 1200))
        && (!('housingType' in data) || data.housingType in ['PROPIA', 'ALQUILADA', 'FAMILIAR', 'OTRA', 'NO_DECLARADA'])
        && optNonNeg(data, 'housingPayment')
        && (!('socialMediaDeclared' in data) || data.socialMediaDeclared in ['YES', 'NO_MEDIA', 'UNANSWERED'])
        && optStr(data, 'socialMediaHandle', 120) && optStr(data, 'altContactName', 160) && optStr(data, 'altContactPhone', 40)
        && isValidId(data.createdBy)
        && (data.createdAt is timestamp || isValidTimestampStr(data.createdAt))
        && data.updatedAt is timestamp;
    }

    function isValidBusiness(data, businessId) {
      return data.keys().hasAll(['id', 'organizationId', 'rnc', 'rncKey', 'legalName', 'authorizedRepName', 'createdBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'organizationId', 'rnc', 'rncKey', 'legalName', 'tradeName',
          'companyType', 'economicActivity', 'operationsStartDate',
          'authorizedRepName', 'authorizedRepDoc', 'corporateDocsSummary',
          'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.id == businessId && isValidId(data.id) && isValidId(data.organizationId)
        && data.rnc is string && data.rnc.size() >= 6 && data.rnc.size() <= 40
        && data.rncKey is string && data.rncKey.size() >= 7 && data.rncKey.size() <= 180
        && data.legalName is string && data.legalName.size() >= 2 && data.legalName.size() <= 200
        && optStr(data, 'tradeName', 200) && optStr(data, 'companyType', 80)
        && optStr(data, 'economicActivity', 160) && optStr(data, 'operationsStartDate', 20)
        && data.authorizedRepName is string && data.authorizedRepName.size() >= 2 && data.authorizedRepName.size() <= 160
        && optStr(data, 'authorizedRepDoc', 40) && optStr(data, 'corporateDocsSummary', 500)
        && isValidId(data.createdBy) && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function isValidApplication(data, applicationId) {
      return data.keys().hasAll([
          'id', 'organizationId', 'applicationNumber', 'fileNumber', 'channel',
          'applicantType', 'customerId', 'applicantDisplayName', 'productCode',
          'currency', 'requestedAmount', 'requestedTermMonths', 'paymentFrequency',
          'amortizationMethod', 'status', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'organizationId', 'applicationNumber', 'fileNumber', 'channel',
          'applicantType', 'customerId', 'businessId', 'applicantDisplayName',
          'productCode', 'currency', 'requestedAmount', 'requestedTermMonths',
          'paymentFrequency', 'amortizationMethod', 'loanPurpose', 'loanPurposeDescription',
          'proposedCollateral', 'financialData', 'businessFinancialData',
          'verifiedFinancialData', 'verifiedBusinessFinancialData',
          'references', 'declaredDocumentsSummary', 'status', 'prequalificationStatus',
          'latestScoringExecutionId', 'latestScore', 'latestRiskBand',
          'recommendedAmount', 'recommendedRateMonthly', 'recommendedTermMonths', 'recommendedInstallment',
          'authorizedAlternateAmount', 'alternateAmountAuthorizedBy',
          'originalRequestedConditions', 'activeFinancialAnalysisId', 'approvedEvaluationAnalysisId',
          'requiresHumanIntervention', 'decisionQualificationStatus', 'financialAnalysisVersion',
          'legalFeeMode', 'interestOnlyPeriods', 'installmentCount',
          'consentVersion', 'consentAcceptedAt', 'assignedTo', 'assignedToName',
          'movementHistory', 'createdBy', 'createdByName', 'createdAt', 'updatedAt'
        ])
        && data.id == applicationId && isValidId(data.id) && isValidId(data.organizationId)
        && data.applicationNumber is string && data.applicationNumber.size() >= 3 && data.applicationNumber.size() <= 64
        && data.fileNumber is string && data.fileNumber.size() >= 3 && data.fileNumber.size() <= 64
        && data.channel in ['INTERNAL', 'EXTERNAL']
        && data.applicantType in ['INDIVIDUAL', 'BUSINESS']
        && isValidId(data.customerId) && optId(data, 'businessId')
        && data.applicantDisplayName is string && data.applicantDisplayName.size() >= 1 && data.applicantDisplayName.size() <= 200
        && data.productCode in ['PERSONAL_DOP', 'EMPRESARIAL_DOP', 'PERSONAL_USD', 'EMPRESARIAL_USD']
        && data.currency in ['DOP', 'USD']
        && data.requestedAmount is number && data.requestedAmount >= 0 && data.requestedAmount <= 100000000
        && data.requestedTermMonths is number && data.requestedTermMonths >= 0 && data.requestedTermMonths <= 360
        && data.paymentFrequency in ['DIARIA', 'SEMANAL', 'QUINCENAL', 'MENSUAL']
        && data.amortizationMethod in ['SALDO_INSOLUTO', 'INTERES_FIJO']
        && optStr(data, 'loanPurpose', 120) && optStr(data, 'loanPurposeDescription', 1000) && optStr(data, 'proposedCollateral', 500)
        && optMap(data, 'financialData') && optMap(data, 'businessFinancialData')
        && optMap(data, 'verifiedFinancialData') && optMap(data, 'verifiedBusinessFinancialData')
        && optList(data, 'references', 4) && optMap(data, 'declaredDocumentsSummary')
        && data.status in ['BORRADOR', 'RECIBIDA', 'EN_EVALUACION', 'EN_COMITE', 'APROBADA', 'APROBADA_CONDICIONADA', 'DEVUELTA', 'RECHAZADA', 'FORMALIZADA', 'DESEMBOLSADA']
        && optStr(data, 'prequalificationStatus', 64) && optId(data, 'latestScoringExecutionId')
        && (!('latestScore' in data) || data.latestScore == null || (data.latestScore is number && data.latestScore >= 0 && data.latestScore <= 100))
        && optStr(data, 'latestRiskBand', 64) && optNum(data, 'recommendedAmount')
        && optNum(data, 'recommendedRateMonthly') && optNum(data, 'recommendedTermMonths') && optNum(data, 'recommendedInstallment')
        && optNum(data, 'authorizedAlternateAmount') && optStr(data, 'alternateAmountAuthorizedBy', 128)
        && optMap(data, 'originalRequestedConditions') && optId(data, 'activeFinancialAnalysisId') && optId(data, 'approvedEvaluationAnalysisId')
        && optBool(data, 'requiresHumanIntervention')
        && (!('decisionQualificationStatus' in data) || data.decisionQualificationStatus == null || data.decisionQualificationStatus in ['CALIFICA_AUTO_EVALUACION', 'REQUIERE_INTERVENCION_HUMANA', 'REEVALUADA_APROBADA_EVALUACION', 'DATOS_INSUFICIENTES'])
        && optNonNeg(data, 'financialAnalysisVersion')
        && (!('legalFeeMode' in data) || data.legalFeeMode == null || data.legalFeeMode in ['DESCONTAR_DESEMBOLSO', 'FINANCIAR'])
        && optNonNeg(data, 'interestOnlyPeriods') && optNonNeg(data, 'installmentCount')
        && optStr(data, 'consentVersion', 40) && optStr(data, 'consentAcceptedAt', 40)
        && optStr(data, 'assignedTo', 128) && optStr(data, 'assignedToName', 160)
        && optList(data, 'movementHistory', 50)
        && isValidId(data.createdBy) && optStr(data, 'createdByName', 160)
        && (data.createdAt is timestamp || isValidTimestampStr(data.createdAt))
        && data.updatedAt is timestamp;
    }

    function isValidApplicationDocument(data, docId) {
      return data.keys().hasAll(['id', 'organizationId', 'applicationId', 'category', 'fileName', 'reviewStatus', 'uploadedBy', 'uploadedAt'])
        && data.keys().hasOnly([
          'id', 'organizationId', 'applicationId', 'category', 'fileName', 'mimeType',
          'sizeBytes', 'fileDataUrl', 'reviewStatus', 'notes', 'uploadedBy', 'uploadedByName',
          'uploadedAt', 'reviewedBy', 'reviewedAt'
        ])
        && data.id == docId && isValidId(data.id) && isValidId(data.organizationId) && isValidId(data.applicationId)
        && data.category is string && data.category.size() >= 2 && data.category.size() <= 80
        && data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 240
        && optStr(data, 'mimeType', 120)
        && (!('sizeBytes' in data) || (data.sizeBytes is number && data.sizeBytes >= 0 && data.sizeBytes <= 10485760))
        && optStr(data, 'fileDataUrl', 700000)
        && data.reviewStatus in ['PENDIENTE', 'RECIBIDO', 'VERIFICADO', 'OBSERVADO']
        && optStr(data, 'notes', 500) && isValidId(data.uploadedBy) && optStr(data, 'uploadedByName', 160)
        && data.uploadedAt is timestamp && optId(data, 'reviewedBy')
        && (!('reviewedAt' in data) || data.reviewedAt == null || data.reviewedAt is timestamp);
    }

    function isValidApplicationConsent(data, consentId) {
      return data.keys().hasAll(['id', 'organizationId', 'applicationId', 'customerId', 'consentVersion', 'acceptedText', 'accepted', 'acceptedBy', 'acceptedAt'])
        && data.keys().hasOnly(['id', 'organizationId', 'applicationId', 'customerId', 'consentVersion', 'acceptedText', 'accepted', 'acceptedBy', 'acceptedAt'])
        && data.id == consentId && isValidId(data.id)
        && isValidId(data.organizationId)
        && isValidId(data.applicationId)
        && isValidId(data.customerId)
        && data.consentVersion is string && data.consentVersion.size() >= 1 && data.consentVersion.size() <= 40
        && data.acceptedText is string && data.acceptedText.size() >= 10 && data.acceptedText.size() <= 2000
        && data.accepted == true
        && isValidId(data.acceptedBy)
        && data.acceptedAt is timestamp;
    }

    function isValidCreditPolicy(data, policyId) {
      return data.keys().hasAll(['id', 'organizationId', 'version', 'status', 'riskBands', 'products', 'capacityConfig', 'exchangeRateConfig', 'approvalAuthorities', 'createdBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'organizationId', 'version', 'name', 'description', 'status',
          'riskBands', 'products', 'capacityConfig', 'exchangeRateConfig',
          'approvalAuthorities', 'workflowConfig', 'indicatorWeights', 'allowedExpenses', 'documentRequirements',
          'approvedBy', 'approvedAt', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.id == policyId && isValidId(data.id)
        && isValidId(data.organizationId)
        && data.version is string && data.version.size() >= 1 && data.version.size() <= 40
        && (!('name' in data) || (data.name is string && data.name.size() <= 160))
        && (!('description' in data) || (data.description is string && data.description.size() <= 1000))
        && data.status in ['PROPUESTA', 'EN_PRUEBAS', 'APROBADA', 'ACTIVA', 'HISTORICA']
        && data.riskBands is list && data.riskBands.size() >= 1 && data.riskBands.size() <= 12
        && data.products is map
        && data.capacityConfig is map
        && data.exchangeRateConfig is map
        && data.approvalAuthorities is list && data.approvalAuthorities.size() <= 20
        && (!('workflowConfig' in data) || (data.workflowConfig is map && data.workflowConfig.stages is list && data.workflowConfig.stages.size() <= 12 && data.workflowConfig.decisionThresholds is map))
        && (!('indicatorWeights' in data) || data.indicatorWeights is map)
        && (!('allowedExpenses' in data) || (data.allowedExpenses is list && data.allowedExpenses.size() <= 20))
        && (!('documentRequirements' in data) || (data.documentRequirements is list && data.documentRequirements.size() <= 20))
        && (!('approvedBy' in data) || data.approvedBy == null || isValidId(data.approvedBy))
