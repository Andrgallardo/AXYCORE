          (isAdmin() && inSameOrg(existing().organizationId)) ||
          (isVerified()
            && existing().userId == request.auth.uid
            && existing().status == 'INVITED'
            && incoming().status == 'ACTIVE'
            && incoming().role == existing().role
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'granularPermissions', 'userDisplayName', 'updatedAt'])
          )
        );
      allow delete: if false;
    }

    match /licenses/{licenseId} {
      allow read: if isVerified() && (isBootstrappedAdmin() || inSameOrg(resource.data.organizationId));
      allow create: if isValidId(licenseId)
        && (isBootstrappedAdmin() || (isAdmin() && inSameOrg(incoming().organizationId)))
        && isValidTenantLicense(incoming(), licenseId)
        && incoming().updatedBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(licenseId) && isBootstrappedAdmin()
        && isValidTenantLicense(incoming(), licenseId)
        && incoming().id == existing().id
        && incoming().organizationId == existing().organizationId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedBy == request.auth.uid
        && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    match /subscriptions/{subId} {
      allow read: if isVerified() && (isBootstrappedAdmin() || inSameOrg(resource.data.organizationId));
      allow create: if isValidId(subId)
        && (isBootstrappedAdmin() || (isAdmin() && inSameOrg(incoming().organizationId)))
        && isValidTenantSubscription(incoming(), subId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(subId) && isBootstrappedAdmin()
        && isValidTenantSubscription(incoming(), subId)
        && incoming().id == existing().id
        && incoming().organizationId == existing().organizationId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    function isValidOperatingExpense(data, expenseId) {
      return data.keys().hasAll([
          'id', 'organizationId', 'expenseNumber', 'expenseDate', 'category',
          'concept', 'vendorName', 'currency', 'amount', 'paymentMethod',
          'status', 'createdBy', 'createdByName', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'organizationId', 'expenseNumber', 'expenseDate', 'category',
          'concept', 'vendorName', 'invoiceNumber', 'currency', 'amount',
          'paymentMethod', 'status', 'notes', 'createdBy', 'createdByName',
          'createdAt', 'updatedAt'
        ])
        && data.id == expenseId && isValidId(data.id)
        && isValidId(data.organizationId)
        && data.expenseNumber is string && data.expenseNumber.size() >= 2 && data.expenseNumber.size() <= 64
        && data.expenseDate is string && data.expenseDate.size() >= 10 && data.expenseDate.size() <= 20
        && data.category in [
          'NOMINA', 'ALQUILER', 'SERVICIOS_BASICOS', 'TECNOLOGIA', 'MARKETING',
          'LEGAL_COBRANZA', 'IMPUESTOS', 'SUMINISTROS', 'INTERESES_INVERSIONISTAS', 'OTROS'
        ]
        && data.concept is string && data.concept.size() >= 2 && data.concept.size() <= 200
        && data.vendorName is string && data.vendorName.size() >= 2 && data.vendorName.size() <= 160
        && (!('invoiceNumber' in data) || (data.invoiceNumber is string && data.invoiceNumber.size() <= 64))
        && data.currency in ['DOP', 'USD']
        && data.amount is number && data.amount > 0 && data.amount <= 1000000000
        && data.paymentMethod in ['TRANSFERENCIA', 'EFECTIVO', 'CHEQUE', 'TARJETA']
        && data.status in ['PAGADO', 'PENDIENTE', 'ANULADO']
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000))
        && isValidId(data.createdBy)
        && data.createdByName is string && data.createdByName.size() >= 1 && data.createdByName.size() <= 160
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidInvestor(data, investorId) {
      return data.keys().hasAll([
          'id', 'organizationId', 'investorCode', 'fullName', 'investorType',
          'documentNumber', 'phone', 'currency', 'annualReturnRatePct', 'joinDate',
          'currentInvestedBalance', 'totalContributed', 'totalWithdrawn', 'totalReturnsPaid',
          'status', 'createdBy', 'createdByName', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'organizationId', 'investorCode', 'fullName', 'investorType',
          'documentNumber', 'phone', 'email', 'currency', 'annualReturnRatePct', 'joinDate',
          'currentInvestedBalance', 'totalContributed', 'totalWithdrawn', 'totalReturnsPaid',
          'status', 'notes', 'createdBy', 'createdByName', 'createdAt', 'updatedAt'
        ])
        && data.id == investorId && isValidId(data.id)
        && isValidId(data.organizationId)
        && data.investorCode is string && data.investorCode.size() >= 2 && data.investorCode.size() <= 64
        && data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 160
        && data.investorType in ['PERSONA_FISICA', 'PERSONA_JURIDICA']
        && data.documentNumber is string && data.documentNumber.size() >= 4 && data.documentNumber.size() <= 40
        && data.phone is string && data.phone.size() >= 7 && data.phone.size() <= 40
        && (!('email' in data) || (data.email is string && data.email.size() <= 254))
        && data.currency in ['DOP', 'USD']
        && data.annualReturnRatePct is number && data.annualReturnRatePct >= 0 && data.annualReturnRatePct <= 200
        && data.joinDate is string && data.joinDate.size() >= 10 && data.joinDate.size() <= 20
        && data.currentInvestedBalance is number && data.currentInvestedBalance >= 0
        && data.totalContributed is number && data.totalContributed >= 0
        && data.totalWithdrawn is number && data.totalWithdrawn >= 0
        && data.totalReturnsPaid is number && data.totalReturnsPaid >= 0
        && data.status in ['ACTIVO', 'INACTIVO']
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000))
        && isValidId(data.createdBy)
        && data.createdByName is string && data.createdByName.size() >= 1 && data.createdByName.size() <= 160
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidInvestorTransaction(data, txId) {
      return data.keys().hasAll([
          'id', 'organizationId', 'investorId', 'investorName', 'transactionType',
          'transactionDate', 'currency', 'amount', 'paymentMethod',
          'createdBy', 'createdByName', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'organizationId', 'investorId', 'investorName', 'transactionType',
          'transactionDate', 'currency', 'amount', 'paymentMethod', 'referenceNumber',
          'notes', 'createdBy', 'createdByName', 'createdAt', 'updatedAt'
        ])
        && data.id == txId && isValidId(data.id)
        && isValidId(data.organizationId)
        && isValidId(data.investorId)
        && data.investorName is string && data.investorName.size() >= 2 && data.investorName.size() <= 160
        && data.transactionType in ['APORTE_CAPITAL', 'RETIRO_CAPITAL', 'PAGO_RENDIMIENTO']
        && data.transactionDate is string && data.transactionDate.size() >= 10 && data.transactionDate.size() <= 20
        && data.currency in ['DOP', 'USD']
        && data.amount is number && data.amount > 0 && data.amount <= 1000000000
        && data.paymentMethod in ['TRANSFERENCIA', 'EFECTIVO', 'CHEQUE', 'TARJETA']
        && (!('referenceNumber' in data) || (data.referenceNumber is string && data.referenceNumber.size() <= 80))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000))
        && isValidId(data.createdBy)
        && data.createdByName is string && data.createdByName.size() >= 1 && data.createdByName.size() <= 160
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /operating_expenses/{expenseId} {
      allow read: if isInternalStaff(resource.data.organizationId);
      allow create: if isValidId(expenseId) && canManageGeneralOperations(incoming().organizationId)
        && isValidOperatingExpense(incoming(), expenseId)
        && incoming().status in ['PAGADO', 'PENDIENTE']
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(expenseId) && canManageGeneralOperations(existing().organizationId)
        && isValidOperatingExpense(incoming(), expenseId)
        && existing().status != 'ANULADO'
        && incoming().id == existing().id
        && incoming().organizationId == existing().organizationId
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'paymentMethod', 'invoiceNumber', 'notes', 'updatedAt']);
      allow delete: if false;
    }

    match /investors/{investorId} {
      allow read: if isInternalStaff(resource.data.organizationId);
      allow create: if isValidId(investorId) && canManageGeneralOperations(incoming().organizationId)
        && isValidInvestor(incoming(), investorId)
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(investorId) && canManageGeneralOperations(existing().organizationId)
        && isValidInvestor(incoming(), investorId)
        && incoming().id == existing().id
        && incoming().organizationId == existing().organizationId
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            incoming().currency == existing().currency
            && incoming().createdBy == existing().createdBy
            && incoming().createdAt == existing().createdAt
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'currentInvestedBalance', 'totalContributed', 'totalWithdrawn', 'totalReturnsPaid',
              'status', 'annualReturnRatePct', 'phone', 'email', 'notes', 'updatedAt'
            ])
          )
        );
      allow delete: if false;
    }

    match /investor_transactions/{txId} {
      allow read: if isInternalStaff(resource.data.organizationId);
      allow create: if isValidId(txId) && canManageGeneralOperations(incoming().organizationId)
        && isValidInvestorTransaction(incoming(), txId)
        && (
          isAdmin() ||
          exists(/databases/$(database)/documents/investors/$(incoming().investorId)) ||
          existsAfter(/databases/$(database)/documents/investors/$(incoming().investorId))
        )
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(txId) && isAdmin() && inSameOrg(existing().organizationId)
        && isValidInvestorTransaction(incoming(), txId)
        && incoming().id == existing().id
        && incoming().organizationId == existing().organizationId;
      allow delete: if false;
    }

    function isValidDashboardWidgetConfig(data, configId) {
      return data.keys().hasAll([
          'id', 'organizationId', 'userId', 'role',
          'sectionOrder', 'hiddenSections',
          'kpiOrder', 'hiddenKpis',
          'alertOrder', 'hiddenAlerts',
          'alertsViewMode', 'updatedBy',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'organizationId', 'userId', 'role',
          'sectionOrder', 'hiddenSections',
          'kpiOrder', 'hiddenKpis',
          'alertOrder', 'hiddenAlerts',
          'alertsViewMode', 'updatedBy',
          'createdAt', 'updatedAt'
        ])
        && data.id == configId && isValidId(data.id)
        && isValidId(data.organizationId)
        && isValidId(data.userId)
        && data.role in [
          'ADMIN', 'BUSINESS_OFFICER', 'CREDIT_ANALYST', 'RISK_OFFICER',
          'COMMITTEE_MEMBER', 'FORMALIZATION', 'OPERATIONS', 'FINANCE',
          'AUDITOR', 'COLLECTION_AGENT', 'SUPERVISOR', 'COLLECTION_COORDINATOR',
          'CASHIER', 'MANAGEMENT', 'EXTERNAL_CLIENT'
        ]
        && data.sectionOrder is list && data.sectionOrder.size() >= 1 && data.sectionOrder.size() <= 9
        && data.sectionOrder[0] is string
        && data.sectionOrder.hasOnly(['executiveSummary', 'performanceOverview', 'panorama', 'intelligence', 'alertsAndActivity', 'performance', 'collections', 'teamProductivity', 'shortcuts'])
        && data.hiddenSections is list && data.hiddenSections.size() <= 9
        && (data.hiddenSections.size() == 0 || data.hiddenSections[0] is string)
        && data.hiddenSections.hasOnly(['executiveSummary', 'performanceOverview', 'panorama', 'intelligence', 'alertsAndActivity', 'performance', 'collections', 'teamProductivity', 'shortcuts'])
        && data.kpiOrder is list && data.kpiOrder.size() >= 1 && data.kpiOrder.size() <= 4
        && data.kpiOrder[0] is string
        && data.kpiOrder.hasOnly(['CARTERA_TOTAL', 'CARTERA_VENCIDA', 'DESEMBOLSOS', 'RECUPERACION'])
        && data.hiddenKpis is list && data.hiddenKpis.size() <= 4
        && (data.hiddenKpis.size() == 0 || data.hiddenKpis[0] is string)
        && data.hiddenKpis.hasOnly(['CARTERA_TOTAL', 'CARTERA_VENCIDA', 'DESEMBOLSOS', 'RECUPERACION'])
        && data.alertOrder is list && data.alertOrder.size() <= 7
        && (data.alertOrder.size() == 0 || data.alertOrder[0] is string)
        && data.alertOrder.hasOnly(['CUOTAS_VENCIDAS', 'PROMESAS_INCUMPLIDAS', 'PROXIMO_VENCER', 'EVALUACION', 'APROBACIONES', 'EXPEDIENTES', 'INCIDENCIAS'])
        && data.hiddenAlerts is list && data.hiddenAlerts.size() <= 7
        && (data.hiddenAlerts.size() == 0 || data.hiddenAlerts[0] is string)
        && data.hiddenAlerts.hasOnly(['CUOTAS_VENCIDAS', 'PROMESAS_INCUMPLIDAS', 'PROXIMO_VENCER', 'EVALUACION', 'APROBACIONES', 'EXPEDIENTES', 'INCIDENCIAS'])
        && data.alertsViewMode in ['CARDS', 'FEED']
        && isValidId(data.updatedBy) && data.updatedBy == request.auth.uid
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /dashboard_widget_configs/{configId} {
      allow read: if isVerified() && inSameOrg(resource.data.organizationId)
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(configId) && isActiveUser() && inSameOrg(incoming().organizationId)
        && isValidDashboardWidgetConfig(incoming(), configId)
        && incoming().userId == request.auth.uid
        && (incoming().role == currentRole() || isBootstrappedAdmin())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(configId) && isActiveUser() && inSameOrg(existing().organizationId)
        && isValidDashboardWidgetConfig(incoming(), configId)
        && existing().userId == request.auth.uid
        && incoming().id == existing().id
        && incoming().organizationId == existing().organizationId
        && incoming().userId == existing().userId
        && incoming().role == existing().role
        && (incoming().role == currentRole() || isBootstrappedAdmin())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'sectionOrder', 'hiddenSections', 'kpiOrder', 'hiddenKpis',
          'alertOrder', 'hiddenAlerts', 'alertsViewMode', 'updatedBy', 'updatedAt'
        ]);
      allow delete: if false;
    }

    // --- Contabilidad & Facturación Electrónica DGII (Ley 32-23) ---

    function isValidAccountingAccount(d, accountId) {
      return d.keys().hasOnly([
          'id', 'organizationId', 'code', 'name', 'accountType',
          'normalBalance', 'parentCode', 'isPostable', 'systemTag',
          'status', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && d.id == accountId && isValidId(d.id) && isValidId(d.organizationId)
        && d.code is string && d.code.size() >= 1 && d.code.size() <= 32
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 160
        && d.accountType in ['ACTIVO', 'PASIVO', 'PATRIMONIO', 'INGRESO', 'COSTO', 'GASTO']
        && d.normalBalance in ['DEBITO', 'CREDITO']
        && (!('parentCode' in d) || d.parentCode is string)
        && d.isPostable is bool
        && (!('systemTag' in d) || d.systemTag is string)
        && d.status in ['ACTIVA', 'INACTIVA']
        && isValidId(d.createdBy) && d.createdAt is timestamp && d.updatedAt is timestamp;
    }

    function isValidJournalEntry(d, entryId) {
      return d.keys().hasOnly([
          'id', 'organizationId', 'entryNumber', 'entryDate', 'sourceType',
          'sourceId', 'idempotencyKey', 'currency', 'description', 'referenceDoc',
          'lines', 'totalDebit', 'totalCredit', 'status', 'reversedEntryId',
          'createdBy', 'createdByName', 'createdAt', 'updatedAt'
        ])
        && d.id == entryId && isValidId(d.id) && isValidId(d.organizationId)
        && d.entryNumber is string && d.entryDate is string
        && d.sourceType in ['ECF_EMITIDO', 'ECF_RECIBIDO', 'ECF_NOTA_CREDITO', 'ECF_NOTA_DEBITO', 'COBRO_FACTURA', 'PAGO_PROVEEDOR', 'DESEMBOLSO', 'PAGO_PRESTAMO', 'GASTO_OPERATIVO', 'MANUAL', 'REVERSO']
        && d.sourceId is string && d.idempotencyKey is string
        && d.currency in ['DOP', 'USD']
        && d.description is string && d.description.size() <= 400
        && (!('referenceDoc' in d) || d.referenceDoc is string)
        && d.lines is list && d.lines.size() >= 2 && d.lines.size() <= 50 && d.lines[0] is map
        && d.totalDebit is number && d.totalCredit is number && d.totalDebit > 0
        && d.totalDebit >= d.totalCredit - 0.02 && d.totalDebit <= d.totalCredit + 0.02
        && d.status in ['CONTABILIZADO', 'REVERTIDO']
        && (!('reversedEntryId' in d) || isValidId(d.reversedEntryId))
        && isValidId(d.createdBy) && d.createdByName is string
        && d.createdAt is timestamp && d.updatedAt is timestamp;
    }

    function isValidDgiiFiscalConfig(d, configId) {
      return d.keys().hasOnly([
          'id', 'organizationId', 'rnc', 'legalName', 'tradeName', 'fiscalAddress',
          'municipality', 'province', 'phone', 'email', 'economicActivity',
          'taxpayerType', 'defaultCurrency', 'environment', 'isCertifiedByDgii',
          'certificationStageNotes', 'enabledEcfTypes', 'endpointsByEnv',
          'timeoutMs', 'maxRetries', 'autoPostAccounting', 'accountMapping',
          'updatedBy', 'createdAt', 'updatedAt'
        ])
        && d.id == configId && d.organizationId == configId && isValidId(d.id)
        && d.rnc is string && d.rnc.size() >= 9 && d.rnc.size() <= 20
        && d.legalName is string && d.tradeName is string && d.fiscalAddress is string
        && d.municipality is string && d.province is string && d.phone is string
        && d.email is string && d.economicActivity is string
        && d.taxpayerType in ['PERSONA_JURIDICA', 'PERSONA_FISICA', 'GRAN_CONTRIBUYENTE', 'REGIMEN_ESPECIAL', 'GUBERNAMENTAL']
        && d.defaultCurrency in ['DOP', 'USD']
        && d.environment in ['DESARROLLO', 'PRECERTIFICACION', 'CERTIFICACION', 'PRODUCCION']
        && d.isCertifiedByDgii is bool && (d.environment != 'PRODUCCION' || d.isCertifiedByDgii == true)
        && (!('certificationStageNotes' in d) || d.certificationStageNotes is string)
        && d.enabledEcfTypes is list && d.enabledEcfTypes.size() <= 10
        && d.endpointsByEnv is map && d.accountMapping is map
        && d.timeoutMs is number && d.maxRetries is number && d.autoPostAccounting is bool
        && isValidId(d.updatedBy) && d.createdAt is timestamp && d.updatedAt is timestamp;
    }

    function isValidDgiiCertificate(d, certId) {
      return d.keys().hasOnly([
          'id', 'organizationId', 'alias', 'subjectCn', 'subjectRnc', 'issuerCn',
          'serialNumber', 'fingerprintSha256', 'validFrom', 'validTo', 'status',
          'vaultKeyId', 'hasPrivateKey', 'uploadedBy', 'uploadedByName', 'notes',
          'createdAt', 'updatedAt'
        ])
        && d.id == certId && isValidId(d.id) && isValidId(d.organizationId)
        && d.alias is string && d.subjectCn is string && d.subjectRnc is string && d.issuerCn is string
        && d.serialNumber is string && d.fingerprintSha256 is string
        && isValidTimestampStr(d.validFrom) && isValidTimestampStr(d.validTo)
        && d.status in ['ACTIVO', 'POR_VENCER', 'VENCIDO', 'REVOCADO']
        && isValidId(d.vaultKeyId) && d.hasPrivateKey is bool
        && isValidId(d.uploadedBy) && d.uploadedByName is string
        && (!('notes' in d) || d.notes is string)
        && d.createdAt is timestamp && d.updatedAt is timestamp;
    }

    function isValidDgiiSequence(d, seqId) {
      return d.keys().hasOnly([
          'id', 'organizationId', 'ecfType', 'prefix', 'authorizationNumber',
          'authDate', 'expiryDate', 'startSequence', 'endSequence',
          'lastUsedSequence', 'status', 'notes', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && d.id == seqId && isValidId(d.id) && isValidId(d.organizationId)
        && d.ecfType in ['31', '32', '33', '34', '41', '43', '44', '45', '46', '47']
        && d.prefix is string && d.authorizationNumber is string
        && d.authDate is string && d.expiryDate is string
        && d.startSequence is number && d.endSequence is number && d.lastUsedSequence is number
        && d.startSequence >= 1 && d.endSequence >= d.startSequence
        && d.lastUsedSequence >= d.startSequence - 1 && d.lastUsedSequence <= d.endSequence
        && d.status in ['ACTIVA', 'AGOTADA', 'VENCIDA', 'SUSPENDIDA']
        && (!('notes' in d) || d.notes is string)
        && isValidId(d.createdBy) && d.createdAt is timestamp && d.updatedAt is timestamp;
    }

    function isValidDgiiReceiver(d, recId) {
      return d.keys().hasOnly([
          'id', 'organizationId', 'partyRole', 'idType', 'taxId', 'legalName',
          'tradeName', 'address', 'municipality', 'province', 'email', 'phone',
          'taxRegime', 'linkedCustomerId', 'status', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && d.id == recId && isValidId(d.id) && isValidId(d.organizationId)
        && d.partyRole in ['CLIENTE', 'PROVEEDOR', 'AMBOS']
        && d.idType in ['RNC', 'CEDULA', 'PASAPORTE']
        && d.taxId is string && d.legalName is string && d.address is string
        && d.email is string && d.phone is string
        && d.taxRegime in ['ORDINARIO', 'PST', 'ZONA_FRANCA', 'GUBERNAMENTAL', 'EXTERIOR', 'CONSUMIDOR_FINAL']
        && d.status in ['ACTIVO', 'INACTIVO']
        && isValidId(d.createdBy) && d.createdAt is timestamp && d.updatedAt is timestamp;
    }

    function isValidDgiiProduct(d, prodId) {
      return d.keys().hasOnly([
          'id', 'organizationId', 'sku', 'name', 'description', 'itemType',
          'unitOfMeasure', 'unitPrice', 'currency', 'itbisRate', 'isExempt',
          'otherTaxCode', 'otherTaxRatePct', 'incomeAccountCode', 'expenseAccountCode',
          'status', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && d.id == prodId && isValidId(d.id) && isValidId(d.organizationId)
        && d.sku is string && d.name is string && d.description is string
        && d.itemType in ['BIEN', 'SERVICIO'] && d.unitOfMeasure is string
        && d.unitPrice is number && d.unitPrice >= 0 && d.currency in ['DOP', 'USD']
        && d.itbisRate in [18, 16, 0] && d.isExempt is bool
        && d.otherTaxCode in ['NINGUNO', 'ISC_AD_VALOREM', 'ISC_ESPECIFICO', 'PROPINA_LEGAL', 'CDT_OTROS']
        && d.otherTaxRatePct is number && d.incomeAccountCode is string && d.expenseAccountCode is string
        && d.status in ['ACTIVO', 'INACTIVO']
        && isValidId(d.createdBy) && d.createdAt is timestamp && d.updatedAt is timestamp;
    }

    function isValidDgiiEcfDocument(d, docId) {
      return d.keys().hasOnly([
          'id', 'organizationId', 'direction', 'ecfType', 'eNCF', 'sequenceRangeId',
          'status', 'environment', 'isOfficialDgiiResponse', 'isTestSimulation',
          'issuerRnc', 'issuerName', 'issuerAddress',
          'receiverId', 'receiverIdType', 'receiverTaxId', 'receiverName', 'receiverAddress', 'receiverEmail',
          'issueDate', 'dueDate', 'paymentCondition', 'paymentMethod', 'currency', 'exchangeRate',
          'items', 'subtotal', 'totalDiscount', 'exemptAmount',
          'taxableAmount18', 'taxableAmount16', 'totalItbis', 'otherTaxesTotal', 'totalAmount',
          'referenceEcf', 'referenceDate', 'modificationCode', 'notes',
          'originalXml', 'signedXml', 'xmlHashSha256', 'securityCode', 'signedAt', 'certificateId',
          'qrUrl', 'trackId', 'dgiiStatusText', 'dgiiResponses',
          'commercialApprovalStatus', 'acuseReciboXml', 'aprobacionComercialXml',
          'voidReason', 'accountingEntryId', 'paymentCollectionStatus', 'paymentAccountingEntryId',
          'emailSentAt', 'emailSentTo', 'createdBy', 'createdByName', 'issuedBy', 'issuedAt',
          'createdAt', 'updatedAt'
        ])
        && d.id == docId && isValidId(d.id) && isValidId(d.organizationId)
        && d.direction in ['EMITIDO', 'RECIBIDO']
        && d.ecfType in ['31', '32', '33', '34', '41', '43', '44', '45', '46', '47']
        && d.eNCF is string
        && d.status in ['BORRADOR', 'PENDIENTE_FIRMA', 'FIRMADA', 'PENDIENTE_ENVIO', 'ENVIADA_DGII', 'PENDIENTE_RESPUESTA', 'ACEPTADA', 'ACEPTADA_CONDICIONAL', 'RECHAZADA', 'ANULADA', 'ERROR_COMUNICACION']
        && d.environment in ['DESARROLLO', 'PRECERTIFICACION', 'CERTIFICACION', 'PRODUCCION']
        && d.isOfficialDgiiResponse is bool && d.isTestSimulation is bool
        && d.issuerRnc is string && d.issuerName is string && d.issuerAddress is string
        && d.receiverIdType in ['RNC', 'CEDULA', 'PASAPORTE', 'SIN_ID']
        && d.receiverTaxId is string && d.receiverName is string && d.receiverAddress is string
        && d.issueDate is string && d.paymentCondition in ['CONTADO', 'CREDITO_15', 'CREDITO_30', 'CREDITO_60', 'OTRO']
        && d.paymentMethod in ['EFECTIVO', 'CHEQUE_TRANSFERENCIA', 'TARJETA_CREDITO_DEBITO', 'VENTA_CREDITO', 'BONOS_CERTIFICADOS', 'PERMUTA', 'NOTA_CREDITO', 'OTRAS']
        && d.currency in ['DOP', 'USD'] && d.exchangeRate is number && d.exchangeRate > 0
        && d.items is list && d.items.size() >= 1 && d.items.size() <= 200 && d.items[0] is map
        && d.subtotal is number && d.totalAmount is number && d.totalAmount >= 0
        && d.dgiiResponses is list && d.dgiiResponses.size() <= 60
        && d.commercialApprovalStatus in ['NO_APLICA', 'PENDIENTE', 'ACEPTADA', 'RECHAZADA']
        && d.paymentCollectionStatus in ['NO_APLICA', 'PENDIENTE', 'COBRADA', 'PAGADA']
        && isValidId(d.createdBy) && d.createdByName is string
        && d.createdAt is timestamp && d.updatedAt is timestamp;
    }

    match /accounting_accounts/{accountId} {
      allow read: if isInternalStaff(resource.data.organizationId);
      allow create: if isValidId(accountId) && canManageAccountingAndEcf(incoming().organizationId)
        && isValidAccountingAccount(incoming(), accountId)
        && incoming().createdBy == request.auth.uid && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(accountId) && canManageAccountingAndEcf(existing().organizationId)
        && isValidAccountingAccount(incoming(), accountId)
        && incoming().organizationId == existing().organizationId && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    match /accounting_journal_entries/{entryId} {
      allow read: if isInternalStaff(resource.data.organizationId);
      allow create: if isValidId(entryId) && canManageAccountingAndEcf(incoming().organizationId)
        && isValidJournalEntry(incoming(), entryId)
        && incoming().createdBy == request.auth.uid && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(entryId) && canManageAccountingAndEcf(existing().organizationId)
        && existing().status == 'CONTABILIZADO' && incoming().status == 'REVERTIDO'
        && incoming().reversedEntryId is string && isValidId(incoming().reversedEntryId)
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'reversedEntryId', 'updatedAt']);
      allow delete: if false;
    }

    match /dgii_fiscal_configs/{configId} {
      allow read: if isInternalStaff(resource.data.organizationId);
      allow create: if isValidId(configId) && canManageEcfInfra(incoming().organizationId)
        && isValidDgiiFiscalConfig(incoming(), configId)
        && incoming().updatedBy == request.auth.uid && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(configId) && canManageEcfInfra(existing().organizationId)
        && isValidDgiiFiscalConfig(incoming(), configId)
        && incoming().createdAt == existing().createdAt && incoming().updatedBy == request.auth.uid && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    match /dgii_certificates/{certId} {
      allow read: if isInternalStaff(resource.data.organizationId);
      allow create: if isValidId(certId) && canManageEcfInfra(incoming().organizationId)
        && isValidDgiiCertificate(incoming(), certId)
        && incoming().uploadedBy == request.auth.uid && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(certId) && canManageEcfInfra(existing().organizationId)
        && incoming().status in ['ACTIVO', 'POR_VENCER', 'VENCIDO', 'REVOCADO']
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'notes', 'updatedAt']);
      allow delete: if false;
    }

    match /dgii_encf_sequences/{seqId} {
      allow read: if isInternalStaff(resource.data.organizationId);
      allow create: if isValidId(seqId) && canManageEcfInfra(incoming().organizationId)
        && isValidDgiiSequence(incoming(), seqId)
        && incoming().createdBy == request.auth.uid && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(seqId) && incoming().updatedAt == request.time
        && (
          (
            canManageAccountingAndEcf(existing().organizationId)
            && incoming().lastUsedSequence is number
            && incoming().lastUsedSequence >= existing().lastUsedSequence
            && incoming().lastUsedSequence <= existing().endSequence
            && incoming().status in ['ACTIVA', 'AGOTADA']
            && incoming().diff(existing()).affectedKeys().hasOnly(['lastUsedSequence', 'status', 'updatedAt'])
          )
          || (
            canManageEcfInfra(existing().organizationId)
            && incoming().status in ['ACTIVA', 'AGOTADA', 'VENCIDA', 'SUSPENDIDA']
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'notes', 'expiryDate', 'authorizationNumber', 'updatedAt'])
          )
        );
      allow delete: if false;
    }

    match /dgii_receivers/{recId} {
      allow read: if isInternalStaff(resource.data.organizationId);
      allow create: if isValidId(recId) && canManageAccountingAndEcf(incoming().organizationId)
        && isValidDgiiReceiver(incoming(), recId)
        && incoming().createdBy == request.auth.uid && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(recId) && canManageAccountingAndEcf(existing().organizationId)
        && isValidDgiiReceiver(incoming(), recId)
        && incoming().organizationId == existing().organizationId && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    match /dgii_products/{prodId} {
      allow read: if isInternalStaff(resource.data.organizationId);
      allow create: if isValidId(prodId) && canManageAccountingAndEcf(incoming().organizationId)
        && isValidDgiiProduct(incoming(), prodId)
        && incoming().createdBy == request.auth.uid && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(prodId) && canManageAccountingAndEcf(existing().organizationId)
        && isValidDgiiProduct(incoming(), prodId)
        && incoming().organizationId == existing().organizationId && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    match /dgii_ecf_documents/{docId} {
      allow read: if isInternalStaff(resource.data.organizationId);
      allow create: if isValidId(docId) && canManageAccountingAndEcf(incoming().organizationId)
        && isValidDgiiEcfDocument(incoming(), docId)
        && incoming().createdBy == request.auth.uid && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(docId) && canManageAccountingAndEcf(existing().organizationId)
        && incoming().id == existing().id && incoming().organizationId == existing().organizationId
        && incoming().updatedAt == request.time
        && (
          (existing().status == 'BORRADOR' && isValidDgiiEcfDocument(incoming(), docId) && incoming().createdBy == existing().createdBy && incoming().createdAt == existing().createdAt)
          || (
            incoming().status in ['BORRADOR', 'PENDIENTE_FIRMA', 'FIRMADA', 'PENDIENTE_ENVIO', 'ENVIADA_DGII', 'PENDIENTE_RESPUESTA', 'ACEPTADA', 'ACEPTADA_CONDICIONAL', 'RECHAZADA', 'ANULADA', 'ERROR_COMUNICACION']
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'signedXml', 'securityCode', 'xmlHashSha256', 'signedAt', 'certificateId',
              'qrUrl', 'trackId', 'isOfficialDgiiResponse', 'dgiiStatusText', 'dgiiResponses',
              'commercialApprovalStatus', 'acuseReciboXml', 'aprobacionComercialXml',
              'voidReason', 'accountingEntryId', 'paymentCollectionStatus',
              'paymentAccountingEntryId', 'emailSentAt', 'emailSentTo', 'updatedAt'
            ])
          )
        );
      allow delete: if false;
    }

    match /dgii_audit_logs/{auditId} {
      allow read: if isInternalStaff(resource.data.organizationId);
      allow create: if isValidId(auditId) && isInternalStaff(incoming().organizationId)
        && incoming().keys().hasOnly([
          'id', 'organizationId', 'eventType', 'ecfDocumentId', 'eNCF',
          'environment', 'summary', 'details', 'actorUid', 'actorEmail',
          'actorRole', 'timestampIso', 'createdAt'
        ])
        && incoming().id == auditId && isValidId(incoming().id) && isValidId(incoming().organizationId)
        && incoming().environment in ['DESARROLLO', 'PRECERTIFICACION', 'CERTIFICACION', 'PRODUCCION']
        && incoming().summary is string && incoming().actorUid == request.auth.uid && incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    // --- ALTERA Inteligencia Crediticia Adaptativa ---

    match /altera_scenarios/{scenarioId} {
      allow read: if isInternalStaff(resource.data.organizationId);
      allow create: if isInternalStaff(incoming().organizationId) && !(currentRole() in ['AUDITOR', 'CASHIER', 'FORMALIZATION'])
        && incoming().id == scenarioId && incoming().createdBy == request.auth.uid && incoming().currency in ['DOP', 'USD']
        && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isInternalStaff(existing().organizationId) && !(currentRole() in ['AUDITOR', 'CASHIER', 'FORMALIZATION'])
        && incoming().id == scenarioId && incoming().organizationId == existing().organizationId && incoming().createdBy == existing().createdBy && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    match /altera_recommendations/{recId} {
      allow read: if isInternalStaff(resource.data.organizationId);
      allow create: if isInternalStaff(incoming().organizationId)
        && currentRole() in ['ADMIN', 'CREDIT_ANALYST', 'RISK_OFFICER', 'FINANCE', 'SUPERVISOR', 'COLLECTION_COORDINATOR', 'MANAGEMENT']
        && incoming().id == recId && incoming().createdBy == request.auth.uid && incoming().currency in ['DOP', 'USD']
        && incoming().status in ['GENERADA', 'PENDIENTE_REVISION']
        && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isInternalStaff(existing().organizationId)
        && incoming().id == recId && incoming().organizationId == existing().organizationId && incoming().createdBy == existing().createdBy && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time
        && (
          currentRole() in ['ADMIN', 'RISK_OFFICER', 'COMMITTEE_MEMBER', 'COLLECTION_COORDINATOR', 'MANAGEMENT']
          || (currentRole() in ['CREDIT_ANALYST', 'FINANCE', 'SUPERVISOR'] && existing().status in ['GENERADA', 'PENDIENTE_REVISION'] && incoming().status in ['GENERADA', 'PENDIENTE_REVISION'])
        );
      allow delete: if false;
    }

    match /altera_outcomes/{outcomeId} {
      allow read: if isInternalStaff(resource.data.organizationId);
      allow create: if isInternalStaff(incoming().organizationId)
        && currentRole() in ['ADMIN', 'CREDIT_ANALYST', 'RISK_OFFICER', 'FINANCE', 'SUPERVISOR', 'COLLECTION_COORDINATOR', 'MANAGEMENT']
        && incoming().id == outcomeId && incoming().createdBy == request.auth.uid && incoming().currency in ['DOP', 'USD']
        && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isInternalStaff(existing().organizationId)
        && currentRole() in ['ADMIN', 'RISK_OFFICER', 'COMMITTEE_MEMBER', 'COLLECTION_COORDINATOR', 'MANAGEMENT']
        && incoming().id == outcomeId && incoming().organizationId == existing().organizationId && incoming().createdBy == existing().createdBy && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    match /altera_analyses/{analysisId} {
      allow read: if isInternalStaff(resource.data.organizationId);
      allow create: if isInternalStaff(incoming().organizationId)
        && incoming().id == analysisId && incoming().actorUid == request.auth.uid && incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    match /altera_configs/{configId} {
      allow read: if isInternalStaff(resource.data.organizationId);
      allow create: if isInternalStaff(incoming().organizationId)
        && currentRole() in ['ADMIN', 'RISK_OFFICER', 'COLLECTION_COORDINATOR']
        && incoming().id == configId && incoming().requireHumanApprovalForAllInterventions == true && incoming().updatedBy == request.auth.uid
        && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isInternalStaff(existing().organizationId)
        && currentRole() in ['ADMIN', 'RISK_OFFICER', 'COLLECTION_COORDINATOR']
        && incoming().id == configId && incoming().organizationId == existing().organizationId && incoming().createdAt == existing().createdAt
        && incoming().requireHumanApprovalForAllInterventions == true && incoming().updatedBy == request.auth.uid && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    // --- AxyCore REGULA (32 Tenant-Isolated Regulatory, Risk, PLAFTPADM, Control & Audit Entities) ---

    function isRegulaCol(col) {
      return col is string && col.matches('^regula_[a-z_]{3,40}$');
    }

    match /regula_tenants/{orgId}/{regulaCollection}/{docId} {
      allow read: if isRegulaCol(regulaCollection) && isInternalStaff(orgId);
      allow create: if isRegulaCol(regulaCollection)
        && isValidId(docId)
        && isInternalStaff(orgId)
        && (regulaCollection != 'regula_configuracion' || currentRole() in ['ADMIN', 'RISK_OFFICER', 'MANAGEMENT'])
        && incoming().id == docId
        && incoming().organizationId == orgId
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isRegulaCol(regulaCollection)
        && !(regulaCollection in ['regula_historial', 'regula_aprobaciones'])
        && isValidId(docId)
        && isInternalStaff(orgId)
        && (regulaCollection != 'regula_configuracion' || currentRole() in ['ADMIN', 'RISK_OFFICER', 'MANAGEMENT'])
        && incoming().id == docId
        && incoming().organizationId == orgId
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          regulaCollection != 'regula_ai_consultas'
          || (
            currentRole() in ['ADMIN', 'RISK_OFFICER', 'AUDITOR', 'MANAGEMENT', 'COMMITTEE_MEMBER']
            && incoming().diff(existing()).affectedKeys().hasOnly(['humanValidationStatus', 'validatedBy', 'validatedByName', 'validatedAt', 'updatedAt'])
          )
        );
      allow delete: if false;
    }
  }
}
