    function hasValidPaymentEvidence(data) {
      return (!('receiptEvidenceName' in data) || (data.receiptEvidenceName is string && data.receiptEvidenceName.size() <= 240))
        && (!('receiptEvidenceMimeType' in data) || (data.receiptEvidenceMimeType is string && data.receiptEvidenceMimeType.size() <= 120))
        && (!('receiptEvidenceSizeBytes' in data) || (data.receiptEvidenceSizeBytes is number && data.receiptEvidenceSizeBytes >= 0 && data.receiptEvidenceSizeBytes <= 10485760))
        && (!('receiptEvidenceDataUrl' in data) || (data.receiptEvidenceDataUrl is string && data.receiptEvidenceDataUrl.size() <= 700000));
    }

