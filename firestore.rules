        && data.vapidPublicKeyPrefix is string && data.vapidPublicKeyPrefix.size() >= 4 && data.vapidPublicKeyPrefix.size() <= 32
        && data.subscribedStatuses is list
        && data.subscribedStatuses.size() >= 1
        && data.subscribedStatuses.size() <= 12
        && data.subscribedStatuses[0] is string
        && data.subscribedStatuses.hasOnly([
          'RECIBIDA', 'EN_EVALUACION', 'DEVUELTA', 'EN_COMITE',
          'APROBADA', 'APROBADA_CONDICIONADA', 'RECHAZADA',
          'FORMALIZADA', 'DESEMBOLSADA', 'CANCELADA'
        ])
        && data.platform is string && data.platform.size() >= 1 && data.platform.size() <= 64
        && data.userAgent is string && data.userAgent.size() >= 1 && data.userAgent.size() <= 300
        && data.status in ['ACTIVE', 'REVOKED']
        && isValidTimestampStr(data.lastSeenAt)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserNotification(data, notificationId) {
      return data.keys().hasAll([
          'id', 'organizationId', 'userId', 'type', 'category',
          'priority', 'title', 'message', 'read', 'createdBy',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'organizationId', 'userId', 'type', 'category',
          'priority', 'title', 'message', 'amountLabel', 'targetSection',
          'entityType', 'entityId', 'sourceEventKey', 'actorName',
          'eventTimestampIso', 'read', 'readAt', 'createdBy',
          'createdAt', 'updatedAt'
        ])
        && data.id == notificationId && isValidId(data.id) && isValidId(data.organizationId) && isValidId(data.userId)
        && data.type is string && data.type.size() >= 2 && data.type.size() <= 64
        && data.category in ['CREDITO', 'COBRANZA', 'RIESGO', 'BITACORA', 'SISTEMA']
        && data.priority in ['INMEDIATA', 'ALTA', 'MEDIA']
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 200
        && data.message is string && data.message.size() >= 2 && data.message.size() <= 600
        && optStr(data, 'amountLabel', 80) && optStr(data, 'targetSection', 64) && optStr(data, 'entityType', 64)
        && optStr(data, 'entityId', 128) && optStr(data, 'sourceEventKey', 160) && optStr(data, 'actorName', 160)
        && optStr(data, 'eventTimestampIso', 40) && data.read is bool && optStr(data, 'readAt', 40)
        && isValidId(data.createdBy) && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function isValidOrganizationMembership(data, membershipId) {
      return data.keys().hasAll([
          'id', 'organizationId', 'userId', 'userEmail', 'userDisplayName',
          'role', 'status', 'granularPermissions', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'organizationId', 'tenantId', 'tenant_id', 'organizationName', 'userId', 'userEmail', 'userDisplayName',
          'role', 'status', 'granularPermissions', 'allowedModuleCodes', 'isPrimaryAdmin', 'invitationId', 'invitedBy',
          'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.id == membershipId && isValidId(data.id) && isValidId(data.organizationId)
        && optStr(data, 'tenantId', 128) && optStr(data, 'tenant_id', 128) && optStr(data, 'organizationName', 160)
        && isValidId(data.userId)
        && data.userEmail is string && data.userEmail.size() >= 3 && data.userEmail.size() <= 254
        && data.userDisplayName is string && data.userDisplayName.size() >= 1 && data.userDisplayName.size() <= 160
        && isAllRole(data.role)
        && data.status in ['ACTIVE', 'INACTIVE', 'SUSPENDED', 'INVITED', 'REVOKED']
        && data.granularPermissions is list && data.granularPermissions.size() <= 30
        && optList(data, 'allowedModuleCodes', 60) && optBool(data, 'isPrimaryAdmin')
        && optId(data, 'invitationId') && optStr(data, 'invitedBy', 128)
        && isValidId(data.createdBy) && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function isValidTenantLicense(data, licenseId) {
      return data.keys().hasAll([
          'id', 'organizationId', 'licenseKey', 'planCode', 'status',
          'startDate', 'endDate', 'maxUsers', 'enabledModules', 'autoRenew',
          'updatedBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'organizationId', 'licenseKey', 'planCode', 'status',
          'startDate', 'endDate', 'maxUsers', 'enabledModules', 'autoRenew',
          'notes', 'updatedBy', 'createdAt', 'updatedAt'
        ])
        && data.id == licenseId && isValidId(data.id)
        && isValidId(data.organizationId)
        && data.licenseKey is string && data.licenseKey.size() >= 4 && data.licenseKey.size() <= 80
        && data.planCode in ['BASICO', 'PROFESIONAL', 'EMPRESARIAL', 'CORPORATIVO', 'PERSONALIZADO']
        && data.status in ['PENDIENTE', 'ACTIVA', 'PROXIMA_A_VENCER', 'VENCIDA', 'SUSPENDIDA', 'CANCELADA']
        && data.startDate is string && data.startDate.size() >= 8 && data.startDate.size() <= 40
        && data.endDate is string && data.endDate.size() >= 8 && data.endDate.size() <= 40
        && data.maxUsers is number && data.maxUsers >= 1 && data.maxUsers <= 100000
        && data.enabledModules is list && data.enabledModules.size() <= 60
        && data.autoRenew is bool
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000))
        && isValidId(data.updatedBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTenantSubscription(data, subId) {
      return data.keys().hasAll([
          'id', 'organizationId', 'planCode', 'billingCycle', 'amountUsd',
          'status', 'nextBillingDate', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'organizationId', 'planCode', 'billingCycle', 'amountUsd',
          'status', 'nextBillingDate', 'lastPaymentDate', 'createdAt', 'updatedAt'
        ])
        && data.id == subId && isValidId(data.id)
        && isValidId(data.organizationId)
        && data.planCode in ['BASICO', 'PROFESIONAL', 'EMPRESARIAL', 'CORPORATIVO', 'PERSONALIZADO']
        && data.billingCycle in ['MENSUAL', 'TRIMESTRAL', 'ANUAL']
        && data.amountUsd is number && data.amountUsd >= 0 && data.amountUsd <= 1000000
        && data.status in ['AL_DIA', 'PENDIENTE_PAGO', 'EN_GRACIA', 'SUSPENDIDA', 'CANCELADA']
        && data.nextBillingDate is string && data.nextBillingDate.size() >= 8 && data.nextBillingDate.size() <= 40
        && (!('lastPaymentDate' in data) || data.lastPaymentDate == null || (data.lastPaymentDate is string && data.lastPaymentDate.size() <= 40))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // --- Collection Rules ---

    match /test/connection {
      allow get: if isSignedIn();
      allow list, write: if false;
    }

    match /organizations/{orgId} {
      allow get: if isValidId(orgId) && isVerified();
      allow list: if isVerified();
      allow create: if isValidId(orgId) && (isBootstrappedAdmin() || (isAdmin() && inSameOrg(orgId)))
        && isValidOrganization(incoming(), orgId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(orgId) && (isBootstrappedAdmin() || (isAdmin() && inSameOrg(orgId)))
        && isValidOrganization(incoming(), orgId)
        && incoming().id == existing().id
        && ((!('createdAt' in existing()) || !(existing().createdAt is timestamp)) ? incoming().createdAt == request.time : incoming().createdAt == existing().createdAt)
        && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isVerified() && (request.auth.uid == userId || isAdmin());
      allow list: if isVerified() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isValidId(userId) && isVerified()
        && isValidUser(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (request.auth.uid == userId && (
            (isBootstrappedAdmin() && incoming().role == 'ADMIN') ||
            (incoming().role == 'EXTERNAL_CLIENT' && incoming().status == 'ACTIVE') ||
            ('invitationId' in incoming() && incoming().status == 'ACTIVE' && hasValidInvitation(incoming().invitationId, incoming().role, incoming().organizationId))
          )) ||
          isAdmin()
        );
      allow update: if isValidId(userId) && isVerified()
        && isValidUser(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'role', 'status', 'organizationId', 'isSuperAdmin', 'invitationId', 'invitationStatus', 'invitedBy', 'invitedAt', 'updatedAt'])) ||
          (request.auth.uid == userId && incoming().role == existing().role && incoming().status == existing().status && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'organizationId', 'invitationStatus', 'updatedAt'])) ||
          (request.auth.uid == userId && 'invitationId' in incoming() && incoming().status == 'ACTIVE' && incoming().invitationStatus == 'CONFIRMADA' && hasValidInvitation(incoming().invitationId, incoming().role, incoming().organizationId) && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'role', 'status', 'organizationId', 'invitationId', 'invitationStatus', 'invitedBy', 'invitedAt', 'updatedAt']))
        );
      allow delete: if false;
    }

    match /user_invitations/{invitationId} {
      allow get: if isValidId(invitationId) && isVerified()
        && (isBootstrappedAdmin() || existing().email.lower() == request.auth.token.email.lower() || (isAdmin() && inSameOrg(existing().organizationId)));
      allow list: if isVerified()
        && (isBootstrappedAdmin() || resource.data.email == request.auth.token.email || (isAdmin() && inSameOrg(resource.data.organizationId)));
      allow create: if isValidId(invitationId)
        && (isBootstrappedAdmin() || (isAdmin() && inSameOrg(incoming().organizationId)))
        && isValidUserInvitation(incoming(), invitationId)
        && incoming().invitedBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(invitationId)
        && isValidUserInvitation(incoming(), invitationId)
        && incoming().id == existing().id
        && incoming().organizationId == existing().organizationId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isBootstrappedAdmin() || (isAdmin() && inSameOrg(existing().organizationId))) ||
          (isVerified()
            && existing().email.lower() == request.auth.token.email.lower()
            && existing().status == 'INVITACION_ENVIADA'
            && incoming().status == 'ACCEPTED'
            && incoming().acceptedUid == request.auth.uid
            && incoming().role == existing().role
            && incoming().email == existing().email
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'acceptedUid', 'acceptedAt', 'updatedAt'])
          )
        );
      allow delete: if false;
    }

    match /customers/{customerId} {
      allow get: if isValidId(customerId) && ((resource == null && isActiveUser()) || isInternalStaff(existing().organizationId) || (isActiveUser() && existing().createdBy == request.auth.uid));
      allow list: if isVerified() && (resource.data.createdBy == request.auth.uid || isInternalStaff(resource.data.organizationId));
      allow create: if isValidId(customerId)
        && (canOriginate(incoming().organizationId) || (isInternalStaff(incoming().organizationId) && currentRole() != 'AUDITOR'))
        && isValidCustomer(incoming(), customerId)
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(customerId)
        && isValidCustomer(incoming(), customerId)
        && incoming().id == existing().id
        && incoming().organizationId == existing().organizationId
        && incoming().updatedAt == request.time
        && (
          (isAdmin() && inSameOrg(existing().organizationId)) ||
          (
            incoming().createdBy == existing().createdBy
            && incoming().createdAt == existing().createdAt
            && (isInternalStaff(existing().organizationId) || existing().createdBy == request.auth.uid)
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'firstName', 'lastName', 'birthDate', 'nationality', 'maritalStatus',
              'phone', 'altPhone', 'email', 'address', 'municipality', 'province',
              'residenceMonths', 'housingType', 'housingPayment',
              'socialMediaDeclared', 'socialMediaHandle', 'altContactName', 'altContactPhone',
              'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(customerId) && isBootstrappedAdmin();
    }

    match /businesses/{businessId} {
      allow get: if isValidId(businessId) && ((resource == null && isActiveUser()) || isInternalStaff(existing().organizationId) || (isActiveUser() && existing().createdBy == request.auth.uid));
      allow list: if isVerified() && (resource.data.createdBy == request.auth.uid || isInternalStaff(resource.data.organizationId));
      allow create: if isValidId(businessId) && canOriginate(incoming().organizationId)
        && isValidBusiness(incoming(), businessId)
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(businessId)
        && isValidBusiness(incoming(), businessId)
        && incoming().id == existing().id
        && incoming().organizationId == existing().organizationId
        && incoming().updatedAt == request.time
        && (
          (isAdmin() && inSameOrg(existing().organizationId)) ||
          (
            incoming().createdBy == existing().createdBy
            && incoming().createdAt == existing().createdAt
            && (isInternalStaff(existing().organizationId) || existing().createdBy == request.auth.uid)
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'legalName', 'tradeName', 'companyType', 'economicActivity', 'operationsStartDate',
              'authorizedRepName', 'authorizedRepDoc', 'corporateDocsSummary', 'updatedAt'
            ])
          )
        );
      allow delete: if false;
    }

    function canCreateApplicationByRole(role, inc) {
      return (role != 'AUDITOR' && role != 'NONE')
        && (
          inc.status in ['BORRADOR', 'RECIBIDA'] ||
          (
            inc.status == 'EN_EVALUACION'
            && ('decisionQualificationStatus' in inc)
            && inc.decisionQualificationStatus == 'CALIFICA_AUTO_EVALUACION'
            && ('activeFinancialAnalysisId' in inc) && isValidId(inc.activeFinancialAnalysisId)
            && ('latestScoringExecutionId' in inc) && isValidId(inc.latestScoringExecutionId)
            && (
              exists(/databases/$(database)/documents/financial_analyses/$(inc.activeFinancialAnalysisId)) ||
              existsAfter(/databases/$(database)/documents/financial_analyses/$(inc.activeFinancialAnalysisId))
            )
          ) ||
          (role != 'EXTERNAL_CLIENT' && inc.status in ['EN_EVALUACION', 'EN_COMITE', 'APROBADA', 'APROBADA_CONDICIONADA', 'FORMALIZADA']) ||
          role in ['ADMIN', 'OPERATIONS', 'FINANCE']
        );
    }

    function appEditAllowedKeys() {
      return [
        'applicantDisplayName', 'productCode', 'currency', 'requestedAmount', 'requestedTermMonths',
        'paymentFrequency', 'amortizationMethod', 'loanPurpose', 'loanPurposeDescription',
        'proposedCollateral', 'financialData', 'businessFinancialData', 'references',
        'declaredDocumentsSummary', 'status', 'prequalificationStatus',
        'latestScoringExecutionId', 'latestScore', 'latestRiskBand',
        'recommendedAmount', 'recommendedRateMonthly', 'recommendedTermMonths', 'recommendedInstallment',
        'originalRequestedConditions', 'activeFinancialAnalysisId', 'approvedEvaluationAnalysisId',
        'requiresHumanIntervention', 'decisionQualificationStatus', 'financialAnalysisVersion',
        'legalFeeMode', 'interestOnlyPeriods', 'installmentCount',
        'consentVersion', 'consentAcceptedAt', 'movementHistory', 'updatedAt'
      ];
    }

    function canUpdateApplicationByRole(role, applicationId, inc, ext) {
      return (
        // Action 1a: Originator submits/edits own draft or returned application (cannot jump directly to EN_EVALUACION unless auto-qualified with linked analysis)
        (ext.createdBy == request.auth.uid
          && ext.status in ['BORRADOR', 'DEVUELTA']
          && (
            inc.status in ['BORRADOR', 'RECIBIDA'] ||
            (
              inc.status == 'EN_EVALUACION'
              && ('decisionQualificationStatus' in inc)
              && inc.decisionQualificationStatus == 'CALIFICA_AUTO_EVALUACION'
              && ('activeFinancialAnalysisId' in inc) && isValidId(inc.activeFinancialAnalysisId)
              && (
                exists(/databases/$(database)/documents/financial_analyses/$(inc.activeFinancialAnalysisId)) ||
                existsAfter(/databases/$(database)/documents/financial_analyses/$(inc.activeFinancialAnalysisId))
              )
            )
          )
          && inc.diff(ext).affectedKeys().hasOnly(appEditAllowedKeys())
        ) ||
        // Action 1b: Internal staff updates received/returned/evaluation application & re-evaluates (no unauthorized status jump to EN_EVALUACION without analysis)
        (!(role in ['EXTERNAL_CLIENT', 'NONE', 'AUDITOR'])
          && ext.status in ['BORRADOR', 'RECIBIDA', 'DEVUELTA', 'EN_EVALUACION']
          && (
            inc.status == ext.status ||
            inc.status in ['BORRADOR', 'RECIBIDA', 'DEVUELTA'] ||
            (
              inc.status == 'EN_EVALUACION'
              && role in ['ADMIN', 'CREDIT_ANALYST', 'RISK_OFFICER', 'BUSINESS_OFFICER', 'COMMITTEE_MEMBER', 'MANAGEMENT']
              && ('activeFinancialAnalysisId' in inc) && isValidId(inc.activeFinancialAnalysisId)
              && ('latestScoringExecutionId' in inc) && isValidId(inc.latestScoringExecutionId)
            )
          )
          && inc.diff(ext).affectedKeys().hasOnly(appEditAllowedKeys())
        ) ||
        // Action 1c: Authorized credit staff routes BORRADOR/RECIBIDA/DEVUELTA -> EN_EVALUACION ONLY with persisted financial analysis & scoring (anti-bypass)
        (role in ['ADMIN', 'CREDIT_ANALYST', 'RISK_OFFICER', 'BUSINESS_OFFICER', 'COMMITTEE_MEMBER', 'MANAGEMENT']
          && ext.status in ['BORRADOR', 'RECIBIDA', 'DEVUELTA']
          && inc.status == 'EN_EVALUACION'
          && ('latestScoringExecutionId' in inc) && isValidId(inc.latestScoringExecutionId)
          && ('activeFinancialAnalysisId' in inc) && isValidId(inc.activeFinancialAnalysisId)
          && (
            exists(/databases/$(database)/documents/financial_analyses/$(inc.activeFinancialAnalysisId)) ||
            existsAfter(/databases/$(database)/documents/financial_analyses/$(inc.activeFinancialAnalysisId))
          )
          && inc.diff(ext).affectedKeys().hasOnly([
            'status', 'requestedAmount', 'requestedTermMonths', 'paymentFrequency', 'amortizationMethod',
            'authorizedAlternateAmount', 'alternateAmountAuthorizedBy',
            'prequalificationStatus', 'latestScoringExecutionId', 'latestScore', 'latestRiskBand',
            'recommendedAmount', 'recommendedRateMonthly', 'recommendedTermMonths', 'recommendedInstallment',
            'originalRequestedConditions', 'activeFinancialAnalysisId', 'approvedEvaluationAnalysisId',
            'requiresHumanIntervention', 'decisionQualificationStatus', 'financialAnalysisVersion',
            'legalFeeMode', 'interestOnlyPeriods', 'installmentCount',
            'assignedTo', 'assignedToName', 'movementHistory', 'updatedAt'
          ])
        ) ||
        // Action 2: Automatic scoring & financial analysis attachment (without advancing status)
        (!(role in ['EXTERNAL_CLIENT', 'NONE', 'AUDITOR'])
          && inc.status == ext.status
          && inc.diff(ext).affectedKeys().hasOnly([
            'prequalificationStatus', 'latestScoringExecutionId', 'latestScore', 'latestRiskBand',
            'recommendedAmount', 'recommendedRateMonthly', 'recommendedTermMonths', 'recommendedInstallment',
            'originalRequestedConditions', 'activeFinancialAnalysisId', 'approvedEvaluationAnalysisId',
            'requiresHumanIntervention', 'decisionQualificationStatus', 'financialAnalysisVersion',
            'legalFeeMode', 'interestOnlyPeriods', 'installmentCount',
            'movementHistory', 'updatedAt'
          ])
        ) ||
        // Action 3a: Analyst evaluation, verified financials & evaluation-stage versioned analysis link
        (role in ['ADMIN', 'CREDIT_ANALYST']
          && inc.status in ['EN_EVALUACION', 'EN_COMITE', 'DEVUELTA']
          && inc.diff(ext).affectedKeys().hasOnly([
            'verifiedFinancialData', 'verifiedBusinessFinancialData', 'declaredDocumentsSummary',
            'status', 'prequalificationStatus', 'latestScoringExecutionId', 'latestScore', 'latestRiskBand',
            'recommendedAmount', 'recommendedRateMonthly', 'recommendedTermMonths', 'recommendedInstallment',
            'activeFinancialAnalysisId', 'approvedEvaluationAnalysisId', 'financialAnalysisVersion',
            'requiresHumanIntervention', 'decisionQualificationStatus',
            'assignedTo', 'assignedToName', 'movementHistory', 'updatedAt'
          ])
        ) ||
        // Action 3b: Risk Officer independent review, V2 stress/recalc & escalation/return
        (role in ['ADMIN', 'RISK_OFFICER']
          && inc.status in ['EN_EVALUACION', 'EN_COMITE', 'DEVUELTA']
          && inc.diff(ext).affectedKeys().hasOnly([
            'status', 'prequalificationStatus', 'latestScoringExecutionId', 'latestScore', 'latestRiskBand',
            'recommendedAmount', 'recommendedRateMonthly', 'recommendedTermMonths', 'recommendedInstallment',
            'activeFinancialAnalysisId', 'approvedEvaluationAnalysisId', 'financialAnalysisVersion',
            'movementHistory', 'updatedAt'
          ])
        ) ||
        // Action 4: Committee decision transition
        (role in ['ADMIN', 'COMMITTEE_MEMBER']
          && (role == 'ADMIN' || ext.createdBy != request.auth.uid)
          && ext.status in ['EN_COMITE', 'EN_EVALUACION']
          && inc.status in ['EN_COMITE', 'APROBADA', 'APROBADA_CONDICIONADA', 'DEVUELTA', 'RECHAZADA']
          && inc.diff(ext).affectedKeys().hasOnly(['status', 'movementHistory', 'updatedAt'])
        ) ||
        // Action 5: Formalization transition
        (role in ['ADMIN', 'FORMALIZATION']
          && ext.status in ['APROBADA', 'APROBADA_CONDICIONADA']
          && inc.status == 'FORMALIZADA'
          && inc.diff(ext).affectedKeys().hasOnly(['status', 'movementHistory', 'updatedAt'])
        ) ||
        // Action 6: Disbursement terminal transition
        (role in ['ADMIN', 'OPERATIONS', 'FINANCE']
          && ext.status == 'FORMALIZADA'
          && inc.status == 'DESEMBOLSADA'
          && existsAfter(/databases/$(database)/documents/disbursements/$(applicationId))
          && inc.diff(ext).affectedKeys().hasOnly(['status', 'movementHistory', 'updatedAt'])
        )
      );
    }

    match /applications/{applicationId} {
      allow get: if isValidId(applicationId) && ((resource == null && isActiveUser()) || isInternalStaff(existing().organizationId) || (isActiveUser() && existing().createdBy == request.auth.uid));
      allow list: if isVerified() && (resource.data.createdBy == request.auth.uid || isInternalStaff(resource.data.organizationId));
      allow create: if isValidId(applicationId)
        && inSameOrg(incoming().organizationId)
        && isValidApplication(incoming(), applicationId)
        && incoming().createdBy == request.auth.uid
        && canCreateApplicationByRole(currentRole(), incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          exists(/databases/$(database)/documents/customers/$(incoming().customerId)) ||
          existsAfter(/databases/$(database)/documents/customers/$(incoming().customerId))
        );
      allow update: if isValidId(applicationId)
        && isValidApplication(incoming(), applicationId)
        && incoming().updatedAt == request.time
        && (
          isBootstrappedAdmin() ||
          (isAdmin() && (!('organizationId' in existing()) || inSameOrg(existing().organizationId))) ||
          (
            inSameOrg(existing().organizationId)
            && incoming().id == existing().id
            && incoming().organizationId == existing().organizationId
            && incoming().createdBy == existing().createdBy
            && incoming().createdAt == existing().createdAt
            && (!('originalRequestedConditions' in existing()) || existing().originalRequestedConditions == null || incoming().originalRequestedConditions == existing().originalRequestedConditions)
            && existing().status != 'DESEMBOLSADA'
            && canUpdateApplicationByRole(currentRole(), applicationId, incoming(), existing())
          )
        );
      allow delete: if false;
    }

    match /application_documents/{docId} {
      allow get: if isValidId(docId) && (isInternalStaff(existing().organizationId) || (isActiveUser() && existing().uploadedBy == request.auth.uid));
      allow list: if isVerified() && (resource.data.uploadedBy == request.auth.uid || isInternalStaff(resource.data.organizationId));
      allow create: if isValidId(docId) && (canOriginate(incoming().organizationId) || canDisburse(incoming().organizationId))
        && isValidApplicationDocument(incoming(), docId)
        && incoming().uploadedBy == request.auth.uid
        && incoming().uploadedAt == request.time
        && (
          isAdmin() ||
          exists(/databases/$(database)/documents/applications/$(incoming().applicationId)) ||
          existsAfter(/databases/$(database)/documents/applications/$(incoming().applicationId))
        );
      allow update: if isValidId(docId)
        && isValidApplicationDocument(incoming(), docId)
        && incoming().id == existing().id
        && incoming().organizationId == existing().organizationId
        && (
          (isAdmin() && inSameOrg(existing().organizationId)) ||
          (
            canVerifyDocuments(existing().organizationId)
            && incoming().applicationId == existing().applicationId
            && incoming().uploadedBy == existing().uploadedBy
            && incoming().uploadedAt == existing().uploadedAt
            && incoming().diff(existing()).affectedKeys().hasOnly(['reviewStatus', 'notes', 'reviewedBy', 'reviewedAt'])
          )
        );
      allow delete: if false;
    }

    match /application_consents/{consentId} {
      allow get: if isValidId(consentId) && (isInternalStaff(existing().organizationId) || (isActiveUser() && existing().acceptedBy == request.auth.uid));
      allow list: if isVerified() && (resource.data.acceptedBy == request.auth.uid || isInternalStaff(resource.data.organizationId));
      allow create: if isValidId(consentId)
        && (canOriginate(incoming().organizationId) || (isInternalStaff(incoming().organizationId) && currentRole() != 'AUDITOR'))
        && isValidApplicationConsent(incoming(), consentId)
        && incoming().acceptedBy == request.auth.uid
        && incoming().acceptedAt == request.time;
      allow update, delete: if false;
    }

    match /credit_policies/{policyId} {
      allow get: if isValidId(policyId) && isActiveUser() && inSameOrg(existing().organizationId);
      allow list: if isVerified() && inSameOrg(resource.data.organizationId);
      allow create: if isValidId(policyId) && isAdmin()
        && isValidCreditPolicy(incoming(), policyId)
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(policyId) && isAdmin()
        && existing().status != 'HISTORICA'
        && isValidCreditPolicy(incoming(), policyId)
        && incoming().id == existing().id
        && incoming().organizationId == existing().organizationId
        && incoming().version == existing().version
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'description', 'status', 'riskBands', 'products', 'capacityConfig',
          'exchangeRateConfig', 'approvalAuthorities', 'workflowConfig', 'indicatorWeights',
          'allowedExpenses', 'documentRequirements', 'approvedBy', 'approvedAt', 'updatedAt'
        ]);
      allow delete: if false;
    }

    match /scoring_executions/{execId} {
      allow get: if isValidId(execId) && ((resource == null && isActiveUser()) || isInternalStaff(existing().organizationId) || (isActiveUser() && existing().executedBy == request.auth.uid));
      allow list: if isVerified() && (resource.data.executedBy == request.auth.uid || isInternalStaff(resource.data.organizationId));
      allow create: if isValidId(execId)
        && (canOriginate(incoming().organizationId) || (isInternalStaff(incoming().organizationId) && currentRole() != 'AUDITOR'))
        && isValidScoringExecution(incoming(), execId)
        && incoming().executedBy == request.auth.uid
        && incoming().executedAt == request.time
        && (
          isAdmin() ||
          exists(/databases/$(database)/documents/applications/$(incoming().applicationId)) ||
          existsAfter(/databases/$(database)/documents/applications/$(incoming().applicationId))
        );
      allow update, delete: if false;
    }

    // --- Integrated Financial Analyses, Persisted Amortization Installments & Decision History ---
    // STRICT SECURITY: EXTERNAL_CLIENT has ZERO read/list/update/delete access to internal analyses or schedules.

    function isValidFinancialAnalysis(data, analysisId) {
      return data.keys().hasAll([
          'id', 'organizationId', 'applicationId', 'idempotencyKey', 'version',
          'analysisType', 'status', 'originalRequestedConditions', 'calculatedConditions',
          'decisionSummary', 'installmentsCount', 'canSendToEvaluation',
          'calculatedBy', 'calculatedByName', 'calculatedByRole', 'calculatedAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'organizationId', 'applicationId', 'scoringExecutionId', 'idempotencyKey',
          'version', 'analysisType', 'status', 'originalRequestedConditions', 'calculatedConditions',
          'decisionSummary', 'financialSummary', 'exchangeRateMeta', 'installmentsCount',
          'installmentsPreview', 'canSendToEvaluation', 'sendToEvaluationBlockedReasons',
          'justification', 'calculatedBy', 'calculatedByName', 'calculatedByRole',
          'calculatedAt', 'updatedAt'
        ])
        && data.id == analysisId && isValidId(data.id)
        && isValidId(data.organizationId)
        && isValidId(data.applicationId)
        && (!('scoringExecutionId' in data) || data.scoringExecutionId == null || isValidId(data.scoringExecutionId))
        && data.idempotencyKey is string && data.idempotencyKey.size() >= 6 && data.idempotencyKey.size() <= 128
        && data.version is number && data.version >= 1 && data.version <= 1000
        && data.analysisType in ['SOLICITUD_INICIAL', 'REEVALUACION_HUMANA', 'AJUSTE_EVALUACION', 'ACTUALIZACION_DATOS']
        && data.status in ['VIGENTE', 'HISTORICO', 'APROBADO_EVALUACION', 'RECHAZADO']
        && data.originalRequestedConditions is map
        && data.calculatedConditions is map
        && data.decisionSummary is map
        && (!('financialSummary' in data) || data.financialSummary == null || data.financialSummary is map)
        && (!('exchangeRateMeta' in data) || data.exchangeRateMeta == null || data.exchangeRateMeta is map)
        && data.installmentsCount is number && data.installmentsCount >= 0 && data.installmentsCount <= 10000
        && (!('installmentsPreview' in data) || (data.installmentsPreview is list && data.installmentsPreview.size() <= 120))
        && data.canSendToEvaluation is bool
        && (!('sendToEvaluationBlockedReasons' in data) || (data.sendToEvaluationBlockedReasons is list && data.sendToEvaluationBlockedReasons.size() <= 20))
        && (!('justification' in data) || data.justification == null || (data.justification is string && data.justification.size() <= 1000))
        && isValidId(data.calculatedBy)
        && data.calculatedByName is string && data.calculatedByName.size() >= 1 && data.calculatedByName.size() <= 160
        && data.calculatedByRole is string && data.calculatedByRole.size() >= 2 && data.calculatedByRole.size() <= 64
        && (data.calculatedAt is timestamp || isValidTimestampStr(data.calculatedAt))
        && data.updatedAt is timestamp;
    }

    function isValidFinancialAnalysisInstallment(data, instId) {
      return data.keys().hasAll([
          'id', 'analysisId', 'applicationId', 'organizationId', 'installmentNumber',
          'dueDate', 'stage', 'principalAmount', 'interestAmount', 'totalAmount',
          'remainingBalance', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'analysisId', 'applicationId', 'organizationId', 'installmentNumber',
          'dueDate', 'stage', 'principalAmount', 'interestAmount', 'totalAmount',
          'remainingBalance', 'dopEquivalent', 'createdAt'
        ])
        && data.id == instId && isValidId(data.id)
        && isValidId(data.analysisId)
        && isValidId(data.applicationId)
        && isValidId(data.organizationId)
        && data.installmentNumber is number && data.installmentNumber >= 1 && data.installmentNumber <= 10000
        && data.dueDate is string && data.dueDate.size() >= 8 && data.dueDate.size() <= 20
        && data.stage in ['SOLO_INTERESES', 'NORMAL']
        && data.principalAmount is number && data.principalAmount >= 0
        && data.interestAmount is number && data.interestAmount >= 0
        && data.totalAmount is number && data.totalAmount >= 0
        && data.remainingBalance is number && data.remainingBalance >= 0
        && (!('dopEquivalent' in data) || data.dopEquivalent == null || data.dopEquivalent is map)
        && data.createdAt is timestamp;
    }

    function isValidApplicationDecisionHistory(data, historyId) {
      return data.keys().hasAll([
          'id', 'organizationId', 'applicationId', 'eventType', 'originalConditions',
          'evaluatedConditions', 'previousStatus', 'newStatus', 'qualifies',
          'requiresHumanIntervention', 'rulesPassedCount', 'rulesFailedCount',
          'actorId', 'actorName', 'actorRole', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'organizationId', 'applicationId', 'analysisId', 'scoringExecutionId',
          'eventType', 'originalConditions', 'evaluatedConditions', 'previousStatus',
          'newStatus', 'qualifies', 'requiresHumanIntervention', 'rulesPassedCount',
          'rulesFailedCount', 'unmetReasons', 'changesSummary', 'justification',
          'actorId', 'actorName', 'actorRole', 'createdAt'
        ])
        && data.id == historyId && isValidId(data.id)
        && isValidId(data.organizationId)
        && isValidId(data.applicationId)
        && (!('analysisId' in data) || data.analysisId == null || isValidId(data.analysisId))
        && (!('scoringExecutionId' in data) || data.scoringExecutionId == null || isValidId(data.scoringExecutionId))
        && data.eventType in [
          'INITIAL_AUTO_EVALUATION', 'HUMAN_REEVALUATION_SIMULATION',
          'SENT_TO_EVALUATION_AFTER_REEVALUATION', 'EVALUATION_CONDITIONS_ADJUSTED',
          'RETRY_FINANCIAL_PROCESSING'
        ]
        && data.originalConditions is map
        && data.evaluatedConditions is map
        && data.previousStatus is string && data.previousStatus.size() >= 2 && data.previousStatus.size() <= 40
        && data.newStatus is string && data.newStatus.size() >= 2 && data.newStatus.size() <= 40
        && data.qualifies is bool
        && data.requiresHumanIntervention is bool
        && data.rulesPassedCount is number && data.rulesPassedCount >= 0 && data.rulesPassedCount <= 100
        && data.rulesFailedCount is number && data.rulesFailedCount >= 0 && data.rulesFailedCount <= 100
        && (!('unmetReasons' in data) || (data.unmetReasons is list && data.unmetReasons.size() <= 30))
        && (!('changesSummary' in data) || (data.changesSummary is list && data.changesSummary.size() <= 30))
        && (!('justification' in data) || data.justification == null || (data.justification is string && data.justification.size() <= 1000))
        && isValidId(data.actorId)
        && data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 160
        && data.actorRole is string && data.actorRole.size() >= 2 && data.actorRole.size() <= 64
        && data.createdAt is timestamp;
    }

    match /financial_analyses/{analysisId} {
      // Strictly internal staff only — EXTERNAL_CLIENT is denied all reads and queries
      allow read: if (resource == null && isVerified() && !(currentRole() in ['EXTERNAL_CLIENT', 'NONE']))
        || (resource != null && isInternalStaff(resource.data.organizationId));
      allow create: if isValidId(analysisId)
        && inSameOrg(incoming().organizationId)
        && isValidFinancialAnalysis(incoming(), analysisId)
        && incoming().calculatedBy == request.auth.uid
        && incoming().calculatedAt == request.time
        && incoming().updatedAt == request.time
        && (
          currentRole() in ['ADMIN', 'CREDIT_ANALYST', 'RISK_OFFICER', 'BUSINESS_OFFICER', 'COMMITTEE_MEMBER', 'MANAGEMENT'] ||
          (currentRole() == 'EXTERNAL_CLIENT' && incoming().analysisType == 'SOLICITUD_INICIAL' && incoming().version == 1)
        )
        && (
          isAdmin() ||
          exists(/databases/$(database)/documents/applications/$(incoming().applicationId)) ||
          existsAfter(/databases/$(database)/documents/applications/$(incoming().applicationId))
        );
      allow update: if isValidId(analysisId)
        && canReevaluateCredit(existing().organizationId)
        && incoming().status in ['VIGENTE', 'HISTORICO', 'APROBADO_EVALUACION', 'RECHAZADO']
        && optStr(incoming(), 'justification', 1000)
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'justification', 'updatedAt']);
      allow delete: if false;
    }

    match /financial_analysis_installments/{instId} {
      // Strictly internal staff only — EXTERNAL_CLIENT is denied all reads and queries
      allow read: if (resource == null && isVerified() && !(currentRole() in ['EXTERNAL_CLIENT', 'NONE']))
        || (resource != null && isInternalStaff(resource.data.organizationId));
      allow create: if isValidId(instId)
        && hasOrgRole(incoming().organizationId, ['ADMIN', 'CREDIT_ANALYST', 'RISK_OFFICER', 'BUSINESS_OFFICER', 'COMMITTEE_MEMBER', 'MANAGEMENT', 'EXTERNAL_CLIENT'])
        && isValidFinancialAnalysisInstallment(incoming(), instId)
        && incoming().createdAt == request.time
        && (
          isAdmin() ||
          exists(/databases/$(database)/documents/financial_analyses/$(incoming().analysisId)) ||
          existsAfter(/databases/$(database)/documents/financial_analyses/$(incoming().analysisId))
        );
      allow update, delete: if false;
    }

    match /application_decision_history/{historyId} {
      // Strictly internal staff only — EXTERNAL_CLIENT is denied all reads and queries
      allow read: if (resource == null && isVerified() && !(currentRole() in ['EXTERNAL_CLIENT', 'NONE']))
        || (resource != null && isInternalStaff(resource.data.organizationId));
      allow create: if isValidId(historyId)
        && inSameOrg(incoming().organizationId)
        && isValidApplicationDecisionHistory(incoming(), historyId)
        && incoming().actorId == request.auth.uid
        && incoming().createdAt == request.time
        && (
          currentRole() in ['ADMIN', 'CREDIT_ANALYST', 'RISK_OFFICER', 'BUSINESS_OFFICER', 'COMMITTEE_MEMBER', 'MANAGEMENT'] ||
          (currentRole() == 'EXTERNAL_CLIENT' && incoming().eventType == 'INITIAL_AUTO_EVALUATION')
        )
        && (
          isAdmin() ||
          exists(/databases/$(database)/documents/applications/$(incoming().applicationId)) ||
          existsAfter(/databases/$(database)/documents/applications/$(incoming().applicationId))
        );
      allow update, delete: if false;
    }

    match /credit_evaluations/{evalId} {
      allow get: if isValidId(evalId) && ((resource == null && isActiveUser()) || isInternalStaff(existing().organizationId));
      allow list: if isVerified() && isInternalStaff(resource.data.organizationId);
      allow create: if isValidId(evalId)
        && (
          (canAnalyze(incoming().organizationId) && incoming().analystId == request.auth.uid) ||
          (canReviewRisk(incoming().organizationId) && incoming().riskOfficerId == request.auth.uid)
        )
        && isValidCreditEvaluation(incoming(), evalId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          exists(/databases/$(database)/documents/applications/$(incoming().applicationId)) ||
          existsAfter(/databases/$(database)/documents/applications/$(incoming().applicationId))
        );
      allow update: if isValidId(evalId)
        && isValidCreditEvaluation(incoming(), evalId)
        && incoming().id == existing().id
        && incoming().organizationId == existing().organizationId
        && incoming().applicationId == existing().applicationId
        && incoming().analystId == existing().analystId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          get(/databases/$(database)/documents/applications/$(existing().applicationId)).data.status in ['RECIBIDA', 'EN_EVALUACION', 'DEVUELTA', 'EN_COMITE']
        )
        && (
          (canAnalyze(existing().organizationId) && incoming().diff(existing()).affectedKeys().hasOnly([
            'verifiedSnapshot', 'updatedScoringId', 'identityVerified', 'incomeVerified',
            'obligationsVerified', 'referencesVerified',
            'addressVerified', 'phoneVerified', 'socialMediaVerified',
            'findings', 'observations',
            'technicalReport', 'recommendedDecision', 'recommendedAmount',
            'recommendedRateMonthly', 'recommendedTermMonths', 'recommendedConditions',
            'justification', 'status', 'updatedAt'
          ])) ||
          (canReviewRisk(existing().organizationId) && incoming().diff(existing()).affectedKeys().hasOnly([
            'riskOpinionStatus', 'riskOpinionNotes', 'riskOfficerId', 'riskOfficerName',
            'riskReviewedAt', 'updatedScoringId', 'updatedAt'
          ]))
        );
      allow delete: if false;
    }

    match /committee_decisions/{decId} {
      allow get: if isValidId(decId) && isInternalStaff(existing().organizationId);
      allow list: if isVerified() && isInternalStaff(resource.data.organizationId);
      allow create: if isValidId(decId) && canDecideCommittee(incoming().organizationId)
        && isValidCommitteeDecision(incoming(), decId)
        && incoming().decidedBy == request.auth.uid
        && incoming().decidedAt == request.time
        && (
          isAdmin() ||
          exists(/databases/$(database)/documents/applications/$(incoming().applicationId)) ||
          existsAfter(/databases/$(database)/documents/applications/$(incoming().applicationId))
        );
      allow update: if isValidId(decId) && isAdmin() && inSameOrg(existing().organizationId)
        && isValidCommitteeDecision(incoming(), decId)
        && incoming().id == existing().id
        && incoming().organizationId == existing().organizationId;
      allow delete: if false;
    }

    match /formalizations/{formId} {
      allow get: if isValidId(formId) && ((resource == null && isActiveUser()) || isInternalStaff(existing().organizationId));
      allow list: if isVerified() && isInternalStaff(resource.data.organizationId);
      allow create: if isValidId(formId)
        && hasOrgRole(incoming().organizationId, ['ADMIN', 'FORMALIZATION', 'COMMITTEE_MEMBER', 'OPERATIONS', 'FINANCE'])
        && isValidFormalization(incoming(), formId)
        && incoming().formalizedBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          exists(/databases/$(database)/documents/applications/$(incoming().applicationId)) ||
          existsAfter(/databases/$(database)/documents/applications/$(incoming().applicationId))
        );
      allow update: if isValidId(formId)
        && inSameOrg(existing().organizationId)
        && isValidFormalization(incoming(), formId)
        && incoming().id == existing().id
        && incoming().organizationId == existing().organizationId
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            incoming().applicationId == existing().applicationId
            && incoming().decisionId == existing().decisionId
            && incoming().formalizedBy == existing().formalizedBy
            && incoming().createdAt == existing().createdAt
            && existing().status != 'DESEMBOLSADA'
            && (
              (currentRole() in ['ADMIN', 'FORMALIZATION'] && incoming().diff(existing()).affectedKeys().hasOnly([
                'approvedFinancialAnalysisId', 'financedExpenses', 'totalFinanced', 'deductedExpenses', 'netDisbursementAmount',
                'disbursementTargetDate', 'firstPaymentDate', 'maturityDate', 'totalContractualPayable',
                'contractText', 'promissoryNoteText', 'requiredDocsChecklist', 'conditionsFulfilled',
                'signatures', 'collateralDetails', 'legalReviewConfirmed',
                'promissoryNoteConfirmed', 'contractConfirmed', 'status', 'updatedAt'
              ])) ||
              (currentRole() in ['ADMIN', 'OPERATIONS', 'FINANCE'] && incoming().status == 'DESEMBOLSADA' && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
            )
          )
        );
      allow delete: if false;
    }

    match /disbursements/{disbId} {
      allow get: if isValidId(disbId) && ((resource == null && isActiveUser()) || isInternalStaff(existing().organizationId));
      allow list: if isVerified() && isInternalStaff(resource.data.organizationId);
      allow create: if isValidId(disbId) && canDisburse(incoming().organizationId)
        && isValidDisbursement(incoming(), disbId)
        && incoming().responsibleUserId == request.auth.uid
        && incoming().createdAt == request.time
        && (
          isAdmin() ||
          (exists(/databases/$(database)/documents/applications/$(incoming().applicationId)) && get(/databases/$(database)/documents/applications/$(incoming().applicationId)).data.status in ['FORMALIZADA', 'DESEMBOLSADA']) ||
          (existsAfter(/databases/$(database)/documents/applications/$(incoming().applicationId)) && getAfter(/databases/$(database)/documents/applications/$(incoming().applicationId)).data.status in ['FORMALIZADA', 'DESEMBOLSADA'])
        )
        && (
          isAdmin() ||
          exists(/databases/$(database)/documents/loans/$(incoming().loanId)) ||
          existsAfter(/databases/$(database)/documents/loans/$(incoming().loanId))
        );
      allow update: if isValidId(disbId) && isAdmin() && inSameOrg(existing().organizationId)
        && isValidDisbursement(incoming(), disbId)
        && incoming().id == existing().id
        && incoming().organizationId == existing().organizationId;
      allow delete: if false;
    }

    match /loans/{loanId} {
      allow get: if isValidId(loanId) && ((resource == null && isActiveUser()) || isInternalStaff(existing().organizationId) || (isActiveUser() && existing().createdBy == request.auth.uid));
      allow list: if isVerified() && (resource.data.createdBy == request.auth.uid || isInternalStaff(resource.data.organizationId));
      allow create: if isValidId(loanId)
        && hasOrgRole(incoming().organizationId, ['ADMIN', 'OPERATIONS', 'FINANCE', 'COLLECTION_COORDINATOR', 'MANAGEMENT'])
        && isValidLoan(incoming(), loanId)
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && (
          currentRole() in ['ADMIN', 'FINANCE', 'OPERATIONS', 'COLLECTION_COORDINATOR', 'MANAGEMENT'] ||
          exists(/databases/$(database)/documents/disbursements/$(incoming().applicationId)) ||
          existsAfter(/databases/$(database)/documents/disbursements/$(incoming().applicationId))
        );
      allow update: if isValidId(loanId)
        && inSameOrg(existing().organizationId)
        && isValidLoan(incoming(), loanId)
        && incoming().id == existing().id
        && incoming().organizationId == existing().organizationId
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            incoming().loanNumber == existing().loanNumber
            && incoming().applicationId == existing().applicationId
            && incoming().disbursementId == existing().disbursementId
            && incoming().customerId == existing().customerId
            && incoming().approvedPrincipal == existing().approvedPrincipal
            && incoming().totalFinancedPrincipal == existing().totalFinancedPrincipal
            && incoming().contractualRateMonthly == existing().contractualRateMonthly
            && incoming().termMonths == existing().termMonths
            && incoming().disbursementDate == existing().disbursementDate
            && incoming().firstPaymentDate == existing().firstPaymentDate
            && incoming().maturityDate == existing().maturityDate
            && incoming().createdBy == existing().createdBy
            && incoming().createdAt == existing().createdAt
            && (
              (currentRole() in ['ADMIN', 'FINANCE', 'OPERATIONS', 'COLLECTION_COORDINATOR', 'MANAGEMENT']
                && incoming().diff(existing()).affectedKeys().hasOnly([
                  'currentPrincipalBalance', 'status', 'paidPrincipalTotal',
                  'paidInterestTotal', 'paidLateFeeTotal', 'closedAt',
                  'closureCertificateNumber', 'updatedAt'
                ])) ||
              (currentRole() in ['ADMIN', 'FINANCE', 'OPERATIONS']
                && incoming().status == 'CANCELADO'
                && incoming().currentPrincipalBalance == 0
                && incoming().diff(existing()).affectedKeys().hasOnly([
                  'status', 'closedAt', 'closureCertificateNumber', 'updatedAt'
                ])) ||
              (!(currentRole() in ['EXTERNAL_CLIENT', 'NONE'])
                && existing().status != 'CANCELADO'
                && incoming().status in ['ACTIVO', 'VENCIDO']
                && incoming().currentPrincipalBalance == existing().currentPrincipalBalance
                && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
            )
          )
        );
      allow delete: if isValidId(loanId) && isBootstrappedAdmin();
    }

    match /loan_installments/{instId} {
      allow get: if isValidId(instId) && ((resource == null && isActiveUser()) || isInternalStaff(existing().organizationId) || (isActiveUser() && exists(/databases/$(database)/documents/loans/$(existing().loanId)) && get(/databases/$(database)/documents/loans/$(existing().loanId)).data.createdBy == request.auth.uid));
      allow list: if isVerified() && (isInternalStaff(resource.data.organizationId) || (isActiveUser() && exists(/databases/$(database)/documents/loans/$(resource.data.loanId)) && get(/databases/$(database)/documents/loans/$(resource.data.loanId)).data.createdBy == request.auth.uid));
      allow create: if isValidId(instId) && (canDisburse(incoming().organizationId) || canApplyOrReversePayments(incoming().organizationId))
        && isValidInstallment(incoming(), instId)
        && incoming().createdAt == request.time
        && (
          isAdmin() ||
          canApplyOrReversePayments(incoming().organizationId) ||
          exists(/databases/$(database)/documents/loans/$(incoming().loanId)) ||
          existsAfter(/databases/$(database)/documents/loans/$(incoming().loanId))
        );
      allow update: if isValidId(instId) && isValidInstallment(incoming(), instId)
        && incoming().id == existing().id
        && incoming().organizationId == existing().organizationId
        && incoming().updatedAt == request.time
        && (
          (isAdmin() && inSameOrg(existing().organizationId)) ||
          (
            incoming().loanId == existing().loanId
            && incoming().installmentNumber == existing().installmentNumber
            && incoming().dueDate == existing().dueDate
            && incoming().principalAmount == existing().principalAmount
            && incoming().interestAmount == existing().interestAmount
            && incoming().otherCharges == existing().otherCharges
            && incoming().totalAmount == existing().totalAmount
            && incoming().remainingPrincipalBalance == existing().remainingPrincipalBalance
            && incoming().createdAt == existing().createdAt
            && (
              (canApplyOrReversePayments(existing().organizationId)
                && incoming().diff(existing()).affectedKeys().hasOnly([
                  'status', 'paidPrincipal', 'paidInterest', 'paidOtherCharges',
                  'paidLateFee', 'accruedLateFee', 'paidAt', 'updatedAt'
                ])) ||
              (isInternalStaff(existing().organizationId)
                && existing().status in ['PENDIENTE', 'VENCIDA', 'PARCIAL']
                && incoming().status in ['PENDIENTE', 'VENCIDA', 'PARCIAL']
                && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'accruedLateFee', 'updatedAt']))
            )
          )
        );
      allow delete: if isValidId(instId) && isBootstrappedAdmin();
    }

    match /audit_logs/{logId} {
      allow get: if isValidId(logId) && isInternalStaff(existing().organizationId);
      allow list: if isVerified() && isInternalStaff(resource.data.organizationId);
      allow create: if isValidId(logId) && isActiveUser() && inSameOrg(incoming().organizationId)
        && isValidAuditLog(incoming(), logId)
        && incoming().userId == request.auth.uid
        && incoming().timestamp == request.time;
      allow update, delete: if false;
    }

    match /system_parameters/{paramId} {
      allow get: if isValidId(paramId) && isActiveUser() && inSameOrg(existing().organizationId);
      allow list: if isVerified() && inSameOrg(resource.data.organizationId);
      allow create: if isValidId(paramId) && isAdmin()
        && isValidSystemParameter(incoming(), paramId)
        && incoming().updatedBy == request.auth.uid
        && incoming().updatedAt == request.time;
      allow update: if isValidId(paramId) && isAdmin()
        && isValidSystemParameter(incoming(), paramId)
        && incoming().id == existing().id
        && incoming().organizationId == existing().organizationId
        && incoming().key == existing().key
        && incoming().updatedBy == request.auth.uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['value', 'updatedBy', 'updatedAt']);
